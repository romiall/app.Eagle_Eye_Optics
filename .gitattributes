# Conserver les octets des scripts, catalogues et preuves validés, y compris sur Windows.
*.sql -text
*.json -text
*.log -text
*.zip binary

# Application Laravel / frontend
*.php diff=php
*.blade.php diff=html
*.css diff=css
*.md diff=markdown
# Scripts et fichiers exécutés sous Linux : toujours des fins de ligne LF, même depuis Windows.
*.sh text eol=lf
artisan text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
# Verrous de dépendances : générés, jamais relus ligne à ligne.
composer.lock -diff linguist-generated
package-lock.json -diff linguist-generated
*.png binary
*.webmanifest text eol=lf
# Code et configuration de l'application : LF dans le dépôt ET dans l'arbre de travail, même sur un poste
# Windows en core.autocrlf=true (réglage par défaut de Git for Windows). Pint, Prettier, ESLint et les
# générateurs « --check » comparent des octets : une copie de travail en CRLF les fait échouer sans défaut
# de code. Les catalogues SQL/JSON/journaux restent intacts (-text ci-dessus) ; *.md reste hors de cette
# liste car quelques spécifications sont versionnées en CRLF.
*.php text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.py text eol=lf
*.neon text eol=lf
*.xml text eol=lf
composer.lock text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
.env.example text eol=lf
.npmrc text eol=lf
.nvmrc text eol=lf
.prettierignore text eol=lf
.htaccess text eol=lf
