# Eagle's Eye Optics Medical — exemple de configuration.
# Copier vers .env (jamais versionné) puis lancer « php artisan key:generate ».
# Ce fichier ne contient aucun secret : toutes les valeurs sont fictives ou vides.

APP_NAME="Eagle's Eye Optics Medical"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
# En production, par exemple : APP_URL=https://app.eagleeyeoptic.com (sous-domaine HTTPS dédié)
# APP_URL sert aux URL produites hors requête (artisan, files d'attente, courriels). Les assets de la
# SPA sont des chemins depuis la racine du site : ni APP_URL ni ASSET_URL (à ne pas définir) n'y
# changent rien, et la coquille fonctionne derrière un proxy ou un CDN qui termine TLS (build.md).
APP_URL=http://127.0.0.1:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# Les instants sont stockés en UTC (config/app.php et session MySQL). Le fuseau et la monnaie du
# cabinet sont des paramètres séparés (hypothèses du fichier 15, modifiables).
CLINIC_TIMEZONE=Africa/Douala
CLINIC_CURRENCY=XAF

# Documents TEST tant que les mentions légales, le logo et le régime de taxe ne sont pas validés.
PRODUCTION_DOCUMENTS_ENABLED=false
# Taille maximale d'un original PDF déposé sur le serveur (octets, 5 Mo par défaut).
EEO_DOCUMENT_MAX_BYTES=5242880

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# --- Base MySQL 8.4 / InnoDB -------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eagle_eye_optics
DB_USERNAME=eeo_app
DB_PASSWORD=
DB_TIMEZONE=+00:00
# Les tests ne lisent pas ce fichier : ils utilisent la base isolée eeo_test et les variables
# EEO_TEST_DB_HOST, EEO_TEST_DB_PORT, EEO_TEST_DB_DATABASE, EEO_TEST_DB_USERNAME et
# EEO_TEST_DB_PASSWORD de l'environnement du shell (voir docs/implementation/testing.md).

# --- Tables techniques du framework (séparées des 117 tables métier) ----------
SESSION_DRIVER=database
SESSION_TABLE=fw_sessions
# Inactivité proposée : 30 minutes (fichier 09), à confirmer.
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
# Hôtes (avec port) autorisés à utiliser la session SPA Sanctum.
SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000

CACHE_STORE=database
DB_CACHE_TABLE=fw_cache
DB_CACHE_LOCK_TABLE=fw_cache_locks

QUEUE_CONNECTION=database
DB_QUEUE_TABLE=fw_jobs
DB_QUEUE_BATCH_TABLE=fw_job_batches
DB_QUEUE_FAILED_TABLE=fw_failed_jobs

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local

# --- Courrier et intégrations -------------------------------------------------
# Aucun envoi réel pendant le développement : les courriels sont écrits dans les journaux.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.invalid"
MAIL_FROM_NAME="${APP_NAME}"

# Doubles de test uniquement. Aucune clé fournisseur (Google, Kommo, Meta, SMS) n'est définie
# ici : elles seront ajoutées au .env du serveur avec les lots L2/L3, jamais dans le dépôt.
EEO_INTEGRATIONS_MODE=fake

# Cabinet servi (ULID affiché par « php artisan eeo:setup-clinic ») ; vide = l'unique cabinet de la base.
EEO_CLINIC_ID=
# Validité d'une réauthentification pour les opérations sensibles (secondes).
EEO_REAUTHENTICATION_TTL=900

# Modules ouverts aux utilisateurs (mise en service progressive), séparés par des virgules :
# today, patients, consultations, agenda, sales, stock, workshop, communication, reports, settings.
# Vide : aucun module métier exposé (écran et API). Appartient au déploiement, pas à la gérante.
EEO_ENABLED_MODULES=
# Limites de débit (requêtes par minute) : connexions par adresse IP, recherche de patients et lectures de dossiers
# cliniques par compte.
# Ne les relever que pour les tests automatisés.
EEO_RATE_LOGIN_IP=20
EEO_RATE_PATIENT_SEARCH=120
EEO_RATE_CONSULTATION_READ=60

# --- Facturation, caisse et paiement de l'examen (B01 à B05 ; docs/implementation/billing.md) ---------------
# Contrôle du paiement de l'examen au démarrage d'un examen : off (par défaut, « non contrôlé ») ou billed (facture de
# frais d'examen de la visite réglée, ou dérogation exacte de la gérante). Ne pas activer avant d'avoir configuré
# l'article ci-dessous et d'avoir lu la section « Activer le contrôle du paiement de l'examen » du document.
EEO_EXAM_FEE_CONTROL=off
# Référence de l'article « frais d'examen » du catalogue (réelle, fournie par la cliente : Q04). Vide : aucun article.
EEO_EXAM_FEE_ITEM_REFERENCE=
# Plafond de remise de ligne (en % du brut) pour un compte sans autorité de prix ; 0 = aucune remise sans approbation.
EEO_DISCOUNT_CAP_PERCENT=0
# Modes dont la référence de règlement est obligatoire (séparés par des virgules).
EEO_PAYMENT_REFERENCE_REQUIRED=MTN_MOMO,ORANGE_MONEY,BANK_TRANSFER
# Préfixes des numéros de pièces : format <préfixe>-AAAA-NNNNNN. TEST-* tant que les séries réelles ne sont pas choisies
# avec la gérante (Q03, Q05) ; ne jamais les changer pour « renuméroter » une pièce émise.
EEO_NUMBER_WIDTH=6
EEO_NUMBER_PREFIX_INVOICE=TEST-FAC
EEO_NUMBER_PREFIX_RECEIPT=TEST-REC
EEO_NUMBER_PREFIX_CREDIT_NOTE=TEST-AV
EEO_NUMBER_PREFIX_REFUND=TEST-RMB
# Reprise des créances papier (X01) : série distincte des factures du jour.
EEO_NUMBER_PREFIX_LEGACY_BALANCE=TEST-REP
# Devis (L1D07) : série distincte, jamais un numéro de facture.
EEO_NUMBER_PREFIX_QUOTE=TEST-DEV
# Approbations exactes (B06) : durée de validité, en minutes, d'une approbation accordée par la gérante (1 à 1440).
# Proposition à confirmer avec la gérante (Q07) ; une approbation échue ne redevient jamais valable.
EEO_APPROVAL_TTL_MINUTES=60

# Préparation des postes pour le hors-ligne (O02, module « offline », fermé par défaut). Fichier PEM PRIVÉ de la clé
# ES256 qui signe les grants : créé par « php artisan eeo:offline:signing-key », hors de la racine web, jamais versionné,
# inclus dans la sauvegarde des clés. Vide = storage/app/private/offline/grant-signing.pem.
EEO_OFFLINE_SIGNING_KEY_PATH=
# Validité d'un grant en heures (fichier 19 : 72 h proposées) et plafond d'une durée demandée (à confirmer).
EEO_OFFLINE_GRANT_HOURS=72
EEO_OFFLINE_GRANT_MAX_HOURS=168
# Ressources d'un poste (O03) : taille maximale d'une plage de numéros préparée en une fois, et une seule caisse
# hors-ligne principale (fichier 19, L0 : une ressource financière n'est préparée que si aucun autre poste n'en détient).
EEO_OFFLINE_RANGE_MAX_SIZE=1000
EEO_OFFLINE_SINGLE_FINANCIAL_DEVICE=true

# --- Réglages techniques du chemin central (valeurs par défaut sûres ; ne changer que sur diagnostic) --------------
# Tentatives d'une transaction relancée après un interblocage, et attente maximale d'un verrou de ligne (secondes).
EEO_TRANSACTION_MAX_ATTEMPTS=3
EEO_LOCK_WAIT_TIMEOUT=10
# Écart d'horloge toléré entre un poste et le serveur (secondes) pour les instants fournis par un poste.
EEO_MAX_CLOCK_SKEW=300

# --- Sauvegarde (tools/deploy/backup.sh, lancé par la tâche planifiée du serveur ; lu par ce script seulement) -----
# Dossier des sauvegardes, HORS de la racine web (jamais sous public/) ; vide = ~/eeo-backups.
EEO_BACKUP_DIR=
# Nombre de jours de sauvegardes quotidiennes conservées sur le serveur (copie hors serveur à faire en plus).
EEO_BACKUP_KEEP_DAYS=14
# Fichier de la clé de chiffrement des sauvegardes (HORS du dossier de l'application, 0600 ; copie gardée hors du
# serveur par la responsable). Vide : sauvegarde en clair, consignée NOT_ENCRYPTED. Créer : openssl rand -base64 48.
EEO_BACKUP_KEY_FILE=

VITE_APP_NAME="${APP_NAME}"
