{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eeo.invalid/contracts/snapshots/credit-note.json",
  "title": "Snapshot d'un avoir (credit_notes.snapshot)",
  "description": "Avoir (fichier 11) : facture source, lignes et montants corrigés, motif, taxes selon régime, auteur et autorisation, date. Généré par contracts/tools/build_resources.py : ne pas modifier à la main.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "credit_note_id",
    "number",
    "issued_at",
    "invoice",
    "patient",
    "lines",
    "amount_gross",
    "reason",
    "issued_by",
    "approval_id",
    "tax",
    "clinic",
    "template_version"
  ],
  "properties": {
    "credit_note_id": {
      "$ref": "../schemas/common.json#/$defs/Ulid"
    },
    "number": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "issued_at": {
      "$ref": "../schemas/common.json#/$defs/Instant"
    },
    "invoice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invoice_id",
        "number",
        "issued_at",
        "total_gross"
      ],
      "properties": {
        "invoice_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "issued_at": {
          "$ref": "../schemas/common.json#/$defs/Instant"
        },
        "total_gross": {
          "$ref": "../schemas/common.json#/$defs/MoneyXaf"
        }
      }
    },
    "patient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patient_id",
        "record_number",
        "last_name",
        "first_names"
      ],
      "properties": {
        "patient_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "record_number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "last_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "first_names": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 180
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "invoice_line_id",
          "description",
          "quantity",
          "amount_gross",
          "tax_amount"
        ],
        "properties": {
          "invoice_line_id": {
            "$ref": "../schemas/common.json#/$defs/Ulid"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "quantity": {
            "anyOf": [
              {
                "$ref": "../schemas/common.json#/$defs/Quantity"
              },
              {
                "type": "null"
              }
            ]
          },
          "amount_gross": {
            "$ref": "../schemas/common.json#/$defs/PositiveMoneyXaf"
          },
          "tax_amount": {
            "anyOf": [
              {
                "$ref": "../schemas/common.json#/$defs/MoneyXaf"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "amount_gross": {
      "$ref": "../schemas/common.json#/$defs/PositiveMoneyXaf"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "issued_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "display_name"
      ],
      "properties": {
        "user_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        }
      }
    },
    "approval_id": {
      "$ref": "../schemas/common.json#/$defs/Ulid"
    },
    "tax": {
      "description": "Régime fiscal figé : aucune taxe inventée ; sans règle validée, NO_TAX_CONFIGURED et liste vide.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regime",
        "rules"
      ],
      "properties": {
        "regime": {
          "type": "string",
          "enum": [
            "NO_TAX_CONFIGURED",
            "VALIDATED_RULES"
          ]
        },
        "rules": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tax_rule_id",
              "code",
              "label",
              "rate_percent",
              "validated_at",
              "legal_note"
            ],
            "properties": {
              "tax_rule_id": {
                "$ref": "../schemas/common.json#/$defs/Ulid"
              },
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 180
              },
              "rate_percent": {
                "anyOf": [
                  {
                    "$ref": "../schemas/common.json#/$defs/Rate"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "validated_at": {
                "$ref": "../schemas/common.json#/$defs/NullableInstant"
              },
              "legal_note": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "clinic": {
      "description": "En-tête du cabinet au moment de l'émission ; test_document = true tant que production_documents_enabled est faux (document TEST clairement marqué, fichier 23).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clinic_id",
        "name",
        "address",
        "phone",
        "email",
        "tax_identifier",
        "professional_mentions",
        "document_settings",
        "currency",
        "timezone",
        "test_document"
      ],
      "properties": {
        "clinic_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "address": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "phone": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 32
            },
            {
              "type": "null"
            }
          ]
        },
        "email": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 254
            },
            {
              "type": "null"
            }
          ]
        },
        "tax_identifier": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "professional_mentions": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 4000
            },
            {
              "type": "null"
            }
          ]
        },
        "document_settings": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "$ref": "../schemas/common.json#/$defs/Currency"
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "test_document": {
          "type": "boolean"
        }
      }
    },
    "template_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  }
}
