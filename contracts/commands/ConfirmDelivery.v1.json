{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eeo.invalid/contracts/commands/ConfirmDelivery.v1.json",
  "title": "ConfirmDelivery (charge v1)",
  "description": "Remise liée à la vente : quantités non remises, lot vendable non expiré au jour local, approbation si dette. Généré par contracts/tools/build_commands.py : ne pas modifier à la main.",
  "x-entity-type": "deliveries",
  "x-entity-id-field": "delivery_id",
  "x-permission": "delivery.confirm",
  "x-expected-version": "none",
  "x-direct-route": "POST /invoices/{id}/deliveries",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "delivery_id",
    "invoice_id",
    "delivered_at",
    "credit_delivery_approval_id",
    "lines"
  ],
  "properties": {
    "delivery_id": {
      "$ref": "../schemas/common.json#/$defs/Ulid"
    },
    "invoice_id": {
      "$ref": "../schemas/common.json#/$defs/Ulid"
    },
    "delivered_at": {
      "$ref": "../schemas/common.json#/$defs/Instant"
    },
    "credit_delivery_approval_id": {
      "$ref": "../schemas/common.json#/$defs/NullableUlid"
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "delivery_line_id",
          "invoice_line_id",
          "item_id",
          "quantity",
          "stock_position_id",
          "stock_lot_id",
          "reservation_id",
          "stock_movement_id"
        ],
        "properties": {
          "delivery_line_id": {
            "$ref": "../schemas/common.json#/$defs/Ulid"
          },
          "invoice_line_id": {
            "$ref": "../schemas/common.json#/$defs/Ulid"
          },
          "item_id": {
            "$ref": "../schemas/common.json#/$defs/Ulid"
          },
          "quantity": {
            "$ref": "../schemas/common.json#/$defs/Quantity"
          },
          "stock_position_id": {
            "$ref": "../schemas/common.json#/$defs/NullableUlid"
          },
          "stock_lot_id": {
            "$ref": "../schemas/common.json#/$defs/NullableUlid"
          },
          "reservation_id": {
            "$ref": "../schemas/common.json#/$defs/NullableUlid"
          },
          "stock_movement_id": {
            "$ref": "../schemas/common.json#/$defs/NullableUlid"
          }
        }
      }
    }
  },
  "$defs": {
    "DirectRequest": {
      "description": "Corps de la route directe POST /invoices/{id}/deliveries : même charge + expected_version (Création : expected_version vaut null.) ; en-tête Idempotency-Key obligatoire.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_version",
        "delivery_id",
        "invoice_id",
        "delivered_at",
        "credit_delivery_approval_id",
        "lines"
      ],
      "properties": {
        "expected_version": {
          "type": "null"
        },
        "delivery_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "invoice_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "delivered_at": {
          "$ref": "../schemas/common.json#/$defs/Instant"
        },
        "credit_delivery_approval_id": {
          "$ref": "../schemas/common.json#/$defs/NullableUlid"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "delivery_line_id",
              "invoice_line_id",
              "item_id",
              "quantity",
              "stock_position_id",
              "stock_lot_id",
              "reservation_id",
              "stock_movement_id"
            ],
            "properties": {
              "delivery_line_id": {
                "$ref": "../schemas/common.json#/$defs/Ulid"
              },
              "invoice_line_id": {
                "$ref": "../schemas/common.json#/$defs/Ulid"
              },
              "item_id": {
                "$ref": "../schemas/common.json#/$defs/Ulid"
              },
              "quantity": {
                "$ref": "../schemas/common.json#/$defs/Quantity"
              },
              "stock_position_id": {
                "$ref": "../schemas/common.json#/$defs/NullableUlid"
              },
              "stock_lot_id": {
                "$ref": "../schemas/common.json#/$defs/NullableUlid"
              },
              "reservation_id": {
                "$ref": "../schemas/common.json#/$defs/NullableUlid"
              },
              "stock_movement_id": {
                "$ref": "../schemas/common.json#/$defs/NullableUlid"
              }
            }
          }
        }
      }
    }
  }
}
