{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eeo.invalid/contracts/commands/RegisterStockMovement.v1.json",
  "title": "RegisterStockMovement (charge v1)",
  "description": "Mouvement hors vente (ouverture, casse, ajustement) avec motif et approbation hors vente. Généré par contracts/tools/build_commands.py : ne pas modifier à la main.",
  "x-entity-type": "stock_movements",
  "x-entity-id-field": "movement_id",
  "x-permission": "stock.adjust",
  "x-expected-version": "none",
  "x-direct-route": "POST /stock/movements",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "movement_id",
    "item_id",
    "position_id",
    "lot_id",
    "kind",
    "signed_quantity",
    "unit_cost",
    "approval_id",
    "reason",
    "occurred_at"
  ],
  "properties": {
    "movement_id": {
      "$ref": "../schemas/common.json#/$defs/Ulid"
    },
    "item_id": {
      "$ref": "../schemas/common.json#/$defs/Ulid"
    },
    "position_id": {
      "$ref": "../schemas/common.json#/$defs/Ulid"
    },
    "lot_id": {
      "$ref": "../schemas/common.json#/$defs/NullableUlid"
    },
    "kind": {
      "type": "string",
      "enum": [
        "OPENING",
        "BREAKAGE",
        "ADJUSTMENT"
      ]
    },
    "signed_quantity": {
      "$ref": "../schemas/common.json#/$defs/SignedQuantity"
    },
    "unit_cost": {
      "anyOf": [
        {
          "$ref": "../schemas/common.json#/$defs/MoneyXaf"
        },
        {
          "type": "null"
        }
      ]
    },
    "approval_id": {
      "$ref": "../schemas/common.json#/$defs/NullableUlid"
    },
    "reason": {
      "$ref": "../schemas/common.json#/$defs/Reason"
    },
    "occurred_at": {
      "$ref": "../schemas/common.json#/$defs/Instant"
    }
  },
  "$defs": {
    "DirectRequest": {
      "description": "Corps de la route directe POST /stock/movements : même charge + expected_version (Création : expected_version vaut null.) ; en-tête Idempotency-Key obligatoire.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_version",
        "movement_id",
        "item_id",
        "position_id",
        "lot_id",
        "kind",
        "signed_quantity",
        "unit_cost",
        "approval_id",
        "reason",
        "occurred_at"
      ],
      "properties": {
        "expected_version": {
          "type": "null"
        },
        "movement_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "item_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "position_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "lot_id": {
          "$ref": "../schemas/common.json#/$defs/NullableUlid"
        },
        "kind": {
          "type": "string",
          "enum": [
            "OPENING",
            "BREAKAGE",
            "ADJUSTMENT"
          ]
        },
        "signed_quantity": {
          "$ref": "../schemas/common.json#/$defs/SignedQuantity"
        },
        "unit_cost": {
          "anyOf": [
            {
              "$ref": "../schemas/common.json#/$defs/MoneyXaf"
            },
            {
              "type": "null"
            }
          ]
        },
        "approval_id": {
          "$ref": "../schemas/common.json#/$defs/NullableUlid"
        },
        "reason": {
          "$ref": "../schemas/common.json#/$defs/Reason"
        },
        "occurred_at": {
          "$ref": "../schemas/common.json#/$defs/Instant"
        }
      }
    }
  }
}
