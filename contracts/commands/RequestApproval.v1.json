{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eeo.invalid/contracts/commands/RequestApproval.v1.json",
  "title": "RequestApproval (charge v1)",
  "description": "Demande d'autorisation liée au contenu exact (hash de la charge visée). Généré par contracts/tools/build_commands.py : ne pas modifier à la main.",
  "x-entity-type": "approvals",
  "x-entity-id-field": "approval_id",
  "x-permission": "approval.request",
  "x-expected-version": "none",
  "x-direct-route": "POST /approvals",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval_id",
    "action_code",
    "target_type",
    "target_id",
    "payload_hash",
    "reason",
    "expires_at"
  ],
  "properties": {
    "approval_id": {
      "$ref": "../schemas/common.json#/$defs/Ulid"
    },
    "action_code": {
      "$ref": "../schemas/common.json#/$defs/PermissionCode"
    },
    "target_type": {
      "type": "string",
      "pattern": "^[a-z][a-z_]{1,63}$"
    },
    "target_id": {
      "$ref": "../schemas/common.json#/$defs/Ulid"
    },
    "payload_hash": {
      "$ref": "../schemas/common.json#/$defs/Sha256Hex"
    },
    "reason": {
      "$ref": "../schemas/common.json#/$defs/Reason"
    },
    "expires_at": {
      "$ref": "../schemas/common.json#/$defs/NullableInstant"
    }
  },
  "$defs": {
    "DirectRequest": {
      "description": "Corps de la route directe POST /approvals : même charge + expected_version (Création : expected_version vaut null.) ; en-tête Idempotency-Key obligatoire.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_version",
        "approval_id",
        "action_code",
        "target_type",
        "target_id",
        "payload_hash",
        "reason",
        "expires_at"
      ],
      "properties": {
        "expected_version": {
          "type": "null"
        },
        "approval_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "action_code": {
          "$ref": "../schemas/common.json#/$defs/PermissionCode"
        },
        "target_type": {
          "type": "string",
          "pattern": "^[a-z][a-z_]{1,63}$"
        },
        "target_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "payload_hash": {
          "$ref": "../schemas/common.json#/$defs/Sha256Hex"
        },
        "reason": {
          "$ref": "../schemas/common.json#/$defs/Reason"
        },
        "expires_at": {
          "$ref": "../schemas/common.json#/$defs/NullableInstant"
        }
      }
    }
  }
}
