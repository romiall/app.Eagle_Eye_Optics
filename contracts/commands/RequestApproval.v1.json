{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eeo.invalid/contracts/commands/RequestApproval.v1.json",
  "title": "RequestApproval (charge v1)",
  "description": "Demande d'autorisation liée au contenu exact de l'opération (subject) : le serveur en dérive l'action, la cible et l'empreinte (payload_hash), jamais fournies par le client ; échéance proposée facultative, raccourcie par la décision. Généré par contracts/tools/build_commands.py : ne pas modifier à la main.",
  "x-entity-type": "approvals",
  "x-entity-id-field": "approval_id",
  "x-permission": "approval.request",
  "x-expected-version": "none",
  "x-direct-route": "POST /approvals",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval_id",
    "subject",
    "reason",
    "expires_at"
  ],
  "properties": {
    "approval_id": {
      "$ref": "../schemas/common.json#/$defs/Ulid"
    },
    "subject": {
      "$ref": "#/$defs/ApprovalSubject"
    },
    "reason": {
      "$ref": "../schemas/common.json#/$defs/Reason"
    },
    "expires_at": {
      "$ref": "../schemas/common.json#/$defs/NullableInstant"
    }
  },
  "$defs": {
    "DirectRequest": {
      "description": "Corps de la route directe POST /approvals : même charge + expected_version (Création : expected_version vaut null.) ; en-tête Idempotency-Key obligatoire.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_version",
        "approval_id",
        "subject",
        "reason",
        "expires_at"
      ],
      "properties": {
        "expected_version": {
          "type": "null"
        },
        "approval_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "subject": {
          "$ref": "#/$defs/ApprovalSubject"
        },
        "reason": {
          "$ref": "../schemas/common.json#/$defs/Reason"
        },
        "expires_at": {
          "$ref": "../schemas/common.json#/$defs/NullableInstant"
        }
      }
    },
    "ApprovalSubject": {
      "description": "Contenu exact de l'opération à approuver ; la nature (kind) fixe l'action, la cible et les champs.",
      "oneOf": [
        {
          "$ref": "#/$defs/ExamFeeWaiverSubject"
        },
        {
          "$ref": "#/$defs/DraftLineRightsSubject"
        },
        {
          "$ref": "#/$defs/PaymentReversalSubject"
        },
        {
          "$ref": "#/$defs/CreditNoteSubject"
        },
        {
          "$ref": "#/$defs/RefundSubject"
        },
        {
          "$ref": "#/$defs/CreditDeliverySubject"
        },
        {
          "$ref": "#/$defs/StockMovementSubject"
        },
        {
          "$ref": "#/$defs/CashMovementSubject"
        }
      ]
    },
    "ExamFeeWaiverSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "visit_id",
        "patient_id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "EXAM_FEE_WAIVER"
        },
        "visit_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "patient_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        }
      },
      "description": "Dispense des frais d'examen d'UNE visite de CE patient (action exam_fee.collect, cible visits)."
    },
    "DraftLineRightsSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "invoice_id",
        "patient_id",
        "lines"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "DRAFT_LINE_RIGHTS"
        },
        "invoice_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "patient_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "position",
              "catalog_item_id",
              "description",
              "quantity",
              "unit_price_gross",
              "discount_gross",
              "prescription_id"
            ],
            "properties": {
              "position": {
                "type": "integer",
                "minimum": 1,
                "maximum": 999
              },
              "catalog_item_id": {
                "$ref": "../schemas/common.json#/$defs/NullableUlid"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "quantity": {
                "$ref": "../schemas/common.json#/$defs/Quantity"
              },
              "unit_price_gross": {
                "$ref": "../schemas/common.json#/$defs/MoneyXaf"
              },
              "discount_gross": {
                "$ref": "../schemas/common.json#/$defs/MoneyXaf"
              },
              "prescription_id": {
                "$ref": "../schemas/common.json#/$defs/NullableUlid"
              }
            }
          }
        }
      },
      "description": "Prix hors catalogue, ligne libre ou remise au-delà du plafond : TOUTES les lignes du brouillon telles qu'elles seront enregistrées, sans leurs identifiants (action catalog.manage, cible invoices ; le brouillon peut ne pas encore exister)."
    },
    "PaymentReversalSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "invoice_id",
        "payment_id",
        "amount"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "PAYMENT_REVERSAL"
        },
        "invoice_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "payment_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "amount": {
          "$ref": "../schemas/common.json#/$defs/PositiveMoneyXaf"
        }
      },
      "description": "Contre-écriture d'un paiement (action payment.reverse, cible payments)."
    },
    "CreditNoteSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "invoice_id",
        "amount_gross",
        "lines"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "CREDIT_NOTE"
        },
        "invoice_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "amount_gross": {
          "$ref": "../schemas/common.json#/$defs/PositiveMoneyXaf"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "invoice_line_id",
              "quantity",
              "amount_gross"
            ],
            "properties": {
              "invoice_line_id": {
                "$ref": "../schemas/common.json#/$defs/Ulid"
              },
              "quantity": {
                "anyOf": [
                  {
                    "$ref": "../schemas/common.json#/$defs/Quantity"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "amount_gross": {
                "$ref": "../schemas/common.json#/$defs/PositiveMoneyXaf"
              }
            }
          }
        }
      },
      "description": "Avoir lié aux lignes d'origine (action credit_note.issue, cible invoices)."
    },
    "RefundSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "invoice_id",
        "credit_note_id",
        "amount",
        "method"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "REFUND"
        },
        "invoice_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "credit_note_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "amount": {
          "$ref": "../schemas/common.json#/$defs/PositiveMoneyXaf"
        },
        "method": {
          "$ref": "../schemas/enums.json#/$defs/refunds.method"
        }
      },
      "description": "Remboursement d'un crédit (action refund.execute, cible invoices)."
    },
    "CreditDeliverySubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "invoice_id",
        "amount_due",
        "lines"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "CREDIT_DELIVERY"
        },
        "invoice_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "amount_due": {
          "$ref": "../schemas/common.json#/$defs/PositiveMoneyXaf"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "invoice_line_id",
              "quantity"
            ],
            "properties": {
              "invoice_line_id": {
                "$ref": "../schemas/common.json#/$defs/Ulid"
              },
              "quantity": {
                "$ref": "../schemas/common.json#/$defs/Quantity"
              }
            }
          }
        }
      },
      "description": "Remise au patient d'une facture non soldée : reste dû à l'instant de la demande et quantités remises par ligne d'origine (une entrée par ligne, cumul de la remise) ; un encaissement intervenu entre-temps exige une nouvelle demande (action delivery.confirm, cible invoices)."
    },
    "StockMovementSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "position_id",
        "item_id",
        "lot_id",
        "movement_kind",
        "signed_quantity"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "STOCK_MOVEMENT"
        },
        "position_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "item_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "lot_id": {
          "$ref": "../schemas/common.json#/$defs/NullableUlid"
        },
        "movement_kind": {
          "type": "string",
          "enum": [
            "BREAKAGE",
            "ADJUSTMENT"
          ]
        },
        "signed_quantity": {
          "allOf": [
            {
              "$ref": "../schemas/common.json#/$defs/SignedQuantity"
            },
            {
              "not": {
                "type": "string",
                "pattern": "^-?0(\\.0{1,3})?$"
              }
            }
          ]
        }
      },
      "description": "Casse ou ajustement de stock : position, article, lot, nature et quantité signée exactes (action stock.adjust, cible stock_positions)."
    },
    "CashMovementSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "cash_session_id",
        "movement_kind",
        "signed_amount",
        "expense_category_id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "CASH_MOVEMENT"
        },
        "cash_session_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "movement_kind": {
          "type": "string",
          "enum": [
            "DEPOSIT",
            "WITHDRAWAL",
            "EXPENSE",
            "OPENING_CORRECTION"
          ]
        },
        "signed_amount": {
          "type": "integer",
          "minimum": -1000000000000,
          "maximum": 1000000000000,
          "not": {
            "const": 0
          }
        },
        "expense_category_id": {
          "$ref": "../schemas/common.json#/$defs/NullableUlid"
        }
      },
      "description": "Mouvement d'espèces hors vente d'une session ouverte : nature, montant signé (entrée positive, sortie négative) et catégorie de la dépense exacts (action cash.manage, cible cash_sessions)."
    }
  }
}
