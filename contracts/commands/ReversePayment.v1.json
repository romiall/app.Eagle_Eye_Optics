{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eeo.invalid/contracts/commands/ReversePayment.v1.json",
  "title": "ReversePayment (charge v1)",
  "description": "Contre-écriture d'une erreur comptable : cumul ≤ original, approbation gérante exacte, original conservé. Généré par contracts/tools/build_commands.py : ne pas modifier à la main.",
  "x-entity-type": "invoices",
  "x-entity-id-field": "invoice_id",
  "x-permission": "payment.reverse",
  "x-expected-version": "ledger",
  "x-direct-route": "POST /payments/{id}/reversals",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "invoice_id",
    "payment_id",
    "reversal_id",
    "amount",
    "reason",
    "approval_id"
  ],
  "properties": {
    "invoice_id": {
      "$ref": "../schemas/common.json#/$defs/Ulid"
    },
    "payment_id": {
      "$ref": "../schemas/common.json#/$defs/Ulid"
    },
    "reversal_id": {
      "$ref": "../schemas/common.json#/$defs/Ulid"
    },
    "amount": {
      "$ref": "../schemas/common.json#/$defs/PositiveMoneyXaf"
    },
    "reason": {
      "$ref": "../schemas/common.json#/$defs/Reason"
    },
    "approval_id": {
      "$ref": "../schemas/common.json#/$defs/Ulid"
    }
  },
  "$defs": {
    "DirectRequest": {
      "description": "Corps de la route directe POST /payments/{id}/reversals : même charge + expected_version (ledger_version dérivée : 1 + paiements confirmés + contre-écritures + avoirs émis + remboursements (contrat 23).) ; en-tête Idempotency-Key obligatoire.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_version",
        "invoice_id",
        "payment_id",
        "reversal_id",
        "amount",
        "reason",
        "approval_id"
      ],
      "properties": {
        "expected_version": {
          "$ref": "../schemas/common.json#/$defs/Version"
        },
        "invoice_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "payment_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "reversal_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "amount": {
          "$ref": "../schemas/common.json#/$defs/PositiveMoneyXaf"
        },
        "reason": {
          "$ref": "../schemas/common.json#/$defs/Reason"
        },
        "approval_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        }
      }
    }
  }
}
