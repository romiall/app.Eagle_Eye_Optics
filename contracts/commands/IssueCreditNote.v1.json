{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eeo.invalid/contracts/commands/IssueCreditNote.v1.json",
  "title": "IssueCreditNote (charge v1)",
  "description": "Avoir lié aux lignes d'origine : cumuls ≤ lignes, approbation consommée une fois ; enfants écrits avant l'émission. Généré par contracts/tools/build_commands.py : ne pas modifier à la main.",
  "x-entity-type": "invoices",
  "x-entity-id-field": "invoice_id",
  "x-permission": "credit_note.issue",
  "x-expected-version": "ledger",
  "x-direct-route": "POST /invoices/{id}/credit-notes",
  "x-number-type": "CREDIT_NOTE",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "invoice_id",
    "credit_note_id",
    "number_usage_id",
    "number",
    "amount_gross",
    "reason",
    "approval_id",
    "document_id",
    "lines"
  ],
  "properties": {
    "invoice_id": {
      "$ref": "../schemas/common.json#/$defs/Ulid"
    },
    "credit_note_id": {
      "$ref": "../schemas/common.json#/$defs/Ulid"
    },
    "number_usage_id": {
      "$ref": "../schemas/common.json#/$defs/Ulid"
    },
    "number": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "amount_gross": {
      "$ref": "../schemas/common.json#/$defs/PositiveMoneyXaf"
    },
    "reason": {
      "$ref": "../schemas/common.json#/$defs/Reason"
    },
    "approval_id": {
      "$ref": "../schemas/common.json#/$defs/Ulid"
    },
    "document_id": {
      "$ref": "../schemas/common.json#/$defs/Ulid"
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "credit_note_line_id",
          "invoice_line_id",
          "quantity",
          "amount_gross",
          "reason"
        ],
        "properties": {
          "credit_note_line_id": {
            "$ref": "../schemas/common.json#/$defs/Ulid"
          },
          "invoice_line_id": {
            "$ref": "../schemas/common.json#/$defs/Ulid"
          },
          "quantity": {
            "anyOf": [
              {
                "$ref": "../schemas/common.json#/$defs/Quantity"
              },
              {
                "type": "null"
              }
            ]
          },
          "amount_gross": {
            "$ref": "../schemas/common.json#/$defs/PositiveMoneyXaf"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4000
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "DirectRequest": {
      "description": "Corps de la route directe POST /invoices/{id}/credit-notes : même charge + expected_version (ledger_version dérivée : 1 + paiements confirmés + contre-écritures + avoirs émis + remboursements (contrat 23).) ; en-tête Idempotency-Key obligatoire.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_version",
        "invoice_id",
        "credit_note_id",
        "number_usage_id",
        "number",
        "amount_gross",
        "reason",
        "approval_id",
        "document_id",
        "lines"
      ],
      "properties": {
        "expected_version": {
          "$ref": "../schemas/common.json#/$defs/Version"
        },
        "invoice_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "credit_note_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "number_usage_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "number": {
          "description": "Numéro central attribué par le serveur sous verrou : null dans la requête directe.",
          "type": "null"
        },
        "amount_gross": {
          "$ref": "../schemas/common.json#/$defs/PositiveMoneyXaf"
        },
        "reason": {
          "$ref": "../schemas/common.json#/$defs/Reason"
        },
        "approval_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "document_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "credit_note_line_id",
              "invoice_line_id",
              "quantity",
              "amount_gross",
              "reason"
            ],
            "properties": {
              "credit_note_line_id": {
                "$ref": "../schemas/common.json#/$defs/Ulid"
              },
              "invoice_line_id": {
                "$ref": "../schemas/common.json#/$defs/Ulid"
              },
              "quantity": {
                "anyOf": [
                  {
                    "$ref": "../schemas/common.json#/$defs/Quantity"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "amount_gross": {
                "$ref": "../schemas/common.json#/$defs/PositiveMoneyXaf"
              },
              "reason": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 4000
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
