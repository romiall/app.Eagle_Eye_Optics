{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eeo.invalid/contracts/commands/DecideApproval.v1.json",
  "title": "DecideApproval (charge v1)",
  "description": "Décision de la gérante présente (profil préparé ou réauthentification en ligne), consommable une fois. Généré par contracts/tools/build_commands.py : ne pas modifier à la main.",
  "x-entity-type": "approvals",
  "x-entity-id-field": "approval_id",
  "x-permission": "approval.decide",
  "x-expected-version": "state",
  "x-direct-route": "POST /approvals/{id}/decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval_id",
    "decision",
    "reason"
  ],
  "properties": {
    "approval_id": {
      "$ref": "../schemas/common.json#/$defs/Ulid"
    },
    "decision": {
      "type": "string",
      "enum": [
        "APPROVED",
        "REFUSED"
      ]
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 4000
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "DirectRequest": {
      "description": "Corps de la route directe POST /approvals/{id}/decision : même charge + expected_version (Transition d'état contrôlée sous verrou (statut attendu vérifié par le serveur) ; la table n'a pas de colonne version, que le contrat 23 interdit d'inventer : expected_version vaut null.) ; en-tête Idempotency-Key obligatoire.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_version",
        "approval_id",
        "decision",
        "reason"
      ],
      "properties": {
        "expected_version": {
          "type": "null"
        },
        "approval_id": {
          "$ref": "../schemas/common.json#/$defs/Ulid"
        },
        "decision": {
          "type": "string",
          "enum": [
            "APPROVED",
            "REFUSED"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4000
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
