{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eeo.invalid/contracts/events/DeliveryConfirmed.v1.json",
  "title": "DeliveryConfirmed (charge v1)",
  "description": "Remise liée à une vente confirmée (sorties de stock écrites). Généré par contracts/tools/build_events.py : ne pas modifier à la main.",
  "x-entity-type": "deliveries",
  "type": "object",
  "additionalProperties": false,
  "required": [
