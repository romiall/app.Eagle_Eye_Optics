{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eeo.invalid/contracts/schemas/requests/http.json",
  "title": "Requêtes HTTP des routes sans commande hors-ligne",
  "description": "Corps des routes en ligne ; les routes qui exécutent une commande du journal local utilisent contracts/commands/<Commande>.v1.json#/$defs/DirectRequest. Généré par contracts/tools/build_resources.py : ne pas modifier à la main.",
  "$defs": {
    "LoginRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "login",
        "password"
      ],
      "properties": {
        "login": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "password": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "ReauthenticateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "password"
      ],
      "properties": {
        "password": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "ChangePasswordRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_password",
        "password",
        "password_confirmation"
      ],
      "properties": {
        "current_password": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "password": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "password_confirmation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "CreateStaffRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "login",
        "display_name",
        "password",
        "roles"
      ],
      "properties": {
        "login": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "display_name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 180
        },
        "email": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 254
            },
            {
              "type": "null"
            }
          ]
        },
        "password": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "CASHIER",
              "CLINICIAN",
              "MANAGER",
              "RECEPTION"
            ]
          },
          "maxItems": 4
        }
      }
    },
    "UpdateStaffRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_version"
      ],
      "properties": {
        "expected_version": {
          "$ref": "../../schemas/common.json#/$defs/Version"
        },
        "display_name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 180
        },
        "email": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 254
            },
            {
              "type": "null"
            }
          ]
        },
        "active": {
          "type": "boolean"
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "CASHIER",
              "CLINICIAN",
              "MANAGER",
              "RECEPTION"
            ]
          },
          "maxItems": 4
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "PermissionOverrideRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_version",
        "permission_code",
        "effect",
        "reason"
      ],
      "properties": {
        "expected_version": {
          "$ref": "../../schemas/common.json#/$defs/Version"
        },
        "permission_code": {
          "$ref": "../../schemas/common.json#/$defs/PermissionCode"
        },
        "effect": {
          "type": "string",
          "enum": [
            "ALLOW",
            "DENY",
            "CLEAR"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 1000
        },
        "expires_at": {
          "$ref": "../../schemas/common.json#/$defs/NullableInstant"
        }
      }
    },
    "ResetPasswordRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_version",
        "password",
        "password_confirmation",
        "reason"
      ],
      "properties": {
        "expected_version": {
          "$ref": "../../schemas/common.json#/$defs/Version"
        },
        "password": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "password_confirmation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 1000
        }
      }
    },
    "UpdateClinicSettingsRequest": {
      "description": "Fuseau, monnaie et production_documents_enabled sont refusés (422).",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 180
        },
        "address": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "phone": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 32
            },
            {
              "type": "null"
            }
          ]
        },
        "email": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 254
            },
            {
              "type": "null"
            }
          ]
        },
        "tax_identifier": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "professional_mentions": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 4000
            },
            {
              "type": "null"
            }
          ]
        },
        "document_settings": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "UpdatePrescriptionDraftRequest": {
      "description": "Modification d'une prescription encore DRAFT, en ligne seulement ; jeton de concurrence updated_at. Hors-ligne, une correction est une nouvelle version (CreatePrescription avec supersedes_id).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_updated_at",
        "changes"
      ],
      "properties": {
        "expected_updated_at": {
          "$ref": "../../schemas/common.json#/$defs/Instant"
        },
        "changes": {
          "type": "object",
          "minProperties": 1
        }
      }
    },
    "RescheduleAppointmentRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_version",
        "starts_at",
        "ends_at"
      ],
      "properties": {
        "expected_version": {
          "$ref": "../../schemas/common.json#/$defs/Version"
        },
        "starts_at": {
          "$ref": "../../schemas/common.json#/$defs/Instant"
        },
        "ends_at": {
          "$ref": "../../schemas/common.json#/$defs/Instant"
        },
        "resource_id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        }
      }
    },
    "CancelAppointmentRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_version",
        "reason"
      ],
      "properties": {
        "expected_version": {
          "$ref": "../../schemas/common.json#/$defs/Version"
        },
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 1000
        }
      }
    },
    "CatalogItemRequest": {
      "description": "Création (expected_version null) ou modification d'un article par la gérante (catalog.manage). Les prix réels sont fournis par le cabinet : seules des données fictives sont utilisées en développement.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_version",
        "reference",
        "category_code",
        "name",
        "brand",
        "model",
        "unit_code",
        "quantity_integer_only",
        "sale_price",
        "purchase_cost",
        "tax_rule_id",
        "stock_mode",
        "requires_expiry",
        "low_stock_threshold",
        "expiry_alert_days",
        "active",
        "public_visibility"
      ],
      "properties": {
        "expected_version": {
          "anyOf": [
            {
              "$ref": "../../schemas/common.json#/$defs/Version"
            },
            {
              "type": "null"
            }
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "category_code": {
          "$ref": "../../schemas/common.json#/$defs/Code"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "brand": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "unit_code": {
          "$ref": "../../schemas/common.json#/$defs/Code"
        },
        "quantity_integer_only": {
          "type": "boolean"
        },
        "sale_price": {
          "$ref": "../../schemas/common.json#/$defs/MoneyXaf"
        },
        "purchase_cost": {
          "anyOf": [
            {
              "$ref": "../../schemas/common.json#/$defs/MoneyXaf"
            },
            {
              "type": "null"
            }
          ]
        },
        "tax_rule_id": {
          "$ref": "../../schemas/common.json#/$defs/NullableUlid"
        },
        "stock_mode": {
          "$ref": "../../schemas/enums.json#/$defs/catalog_items.stock_mode"
        },
        "requires_expiry": {
          "type": "boolean"
        },
        "low_stock_threshold": {
          "anyOf": [
            {
              "$ref": "../../schemas/common.json#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "expiry_alert_days": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 3650
            },
            {
              "type": "null"
            }
          ]
        },
        "active": {
          "type": "boolean"
        },
        "public_visibility": {
          "type": "boolean"
        }
      }
    },
    "TaxRuleRequest": {
      "description": "Règle fiscale saisie par la gérante ; validate = true enregistre la validation (réauthentification). Aucune taxe n'est préconfigurée.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_version",
        "code",
        "label",
        "rate_percent",
        "active",
        "validate",
        "legal_note"
      ],
      "properties": {
        "expected_version": {
          "anyOf": [
            {
              "$ref": "../../schemas/common.json#/$defs/Version"
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "rate_percent": {
          "anyOf": [
            {
              "$ref": "../../schemas/common.json#/$defs/Rate"
            },
            {
              "type": "null"
            }
          ]
        },
        "active": {
          "type": "boolean"
        },
        "validate": {
          "type": "boolean"
        },
        "legal_note": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "AbandonInvoiceDraftRequest": {
      "description": "Abandon d'un brouillon de facture (fichier 03) : version de brouillon attendue, motif facultatif (conservé dans l'audit). Aucun numéro, aucune réserve, aucun document à annuler.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_version",
        "invoice_id",
        "reason"
      ],
      "properties": {
        "expected_version": {
          "$ref": "../../schemas/common.json#/$defs/Version"
        },
        "invoice_id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "OpeningStockRequest": {
      "description": "Stock initial validé (I00) : un mouvement OPENING par ligne, lots créés au besoin ; gérante.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "counted_at",
        "reason",
        "approval_id",
        "lines"
      ],
      "properties": {
        "counted_at": {
          "$ref": "../../schemas/common.json#/$defs/Instant"
        },
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 1000
        },
        "approval_id": {
          "$ref": "../../schemas/common.json#/$defs/NullableUlid"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "movement_id",
              "item_id",
              "location_id",
              "lot",
              "quantity",
              "unit_cost"
            ],
            "properties": {
              "movement_id": {
                "$ref": "../../schemas/common.json#/$defs/Ulid"
              },
              "item_id": {
                "$ref": "../../schemas/common.json#/$defs/Ulid"
              },
              "location_id": {
                "$ref": "../../schemas/common.json#/$defs/Ulid"
              },
              "lot": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "lot_id",
                      "batch_number",
                      "expires_on"
                    ],
                    "properties": {
                      "lot_id": {
                        "$ref": "../../schemas/common.json#/$defs/Ulid"
                      },
                      "batch_number": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "expires_on": {
                        "$ref": "../../schemas/common.json#/$defs/NullableCivilDate"
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "quantity": {
                "$ref": "../../schemas/common.json#/$defs/Quantity"
              },
              "unit_cost": {
                "anyOf": [
                  {
                    "$ref": "../../schemas/common.json#/$defs/MoneyXaf"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "maxItems": 500
        }
      }
    },
    "EnrollDeviceRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_code",
        "name",
        "public_key_jwk",
        "responsible_user_id",
        "app_version"
      ],
      "properties": {
        "device_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "public_key_jwk": {
          "$ref": "../resources/operations.json#/$defs/PublicJwk"
        },
        "responsible_user_id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "app_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "PrepareDeviceRequest": {
      "description": "Préparation en ligne (gérante) : profils à préparer, plages demandées, quotas et créances à attribuer à ce poste.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profiles",
        "number_ranges",
        "stock_quotas",
        "invoice_ids",
        "known_catalog_version"
      ],
      "properties": {
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../../schemas/common.json#/$defs/Ulid"
          },
          "maxItems": 10
        },
        "number_ranges": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "document_type",
              "quantity"
            ],
            "properties": {
              "document_type": {
                "$ref": "../../schemas/enums.json#/$defs/document_number_allocations.document_type"
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5000
              }
            }
          }
        },
        "stock_quotas": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stock_position_id",
              "stock_lot_id",
              "quantity"
            ],
            "properties": {
              "stock_position_id": {
                "$ref": "../../schemas/common.json#/$defs/Ulid"
              },
              "stock_lot_id": {
                "$ref": "../../schemas/common.json#/$defs/NullableUlid"
              },
              "quantity": {
                "$ref": "../../schemas/common.json#/$defs/Quantity"
              }
            }
          }
        },
        "invoice_ids": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "../../schemas/common.json#/$defs/Ulid"
          }
        },
        "known_catalog_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ReleaseDeviceRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "last_device_sequence",
        "last_event_hash",
        "reason"
      ],
      "properties": {
        "last_device_sequence": {
          "$ref": "../../schemas/common.json#/$defs/Counter"
        },
        "last_event_hash": {
          "$ref": "../../schemas/common.json#/$defs/NullableSha256Hex"
        },
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 1000
        }
      }
    },
    "ConflictResolutionRequest": {
      "description": "Résolution autorisée et motivée ; ne réécrit jamais core/hash/signature ; une correction a sa propre command_id (contrat 23).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "reason",
        "correction_command_id"
      ],
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "ACCEPT_LOCAL",
            "KEEP_CENTRAL",
            "REJECT",
            "CORRECT"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 1000
        },
        "correction_command_id": {
          "$ref": "../../schemas/common.json#/$defs/NullableUlid"
        }
      }
    },
    "CreateExportRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "export_type"
      ],
      "properties": {
        "export_type": {
          "$ref": "../../schemas/enums.json#/$defs/export_requests.export_type"
        },
        "patient_id": {
          "$ref": "../../schemas/common.json#/$defs/NullableUlid"
        },
        "filters": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "BookingRequest": {
      "description": "Réservation publique (L2) : consentement explicite exigé, anti-abus et idempotence.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_id",
        "starts_at",
        "name",
        "phone",
        "consent"
      ],
      "properties": {
        "service_id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "starts_at": {
          "$ref": "../../schemas/common.json#/$defs/Instant"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "phone": {
          "$ref": "../../schemas/common.json#/$defs/Phone"
        },
        "email": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 254
            },
            {
              "type": "null"
            }
          ]
        },
        "consent": {
          "const": true
        }
      }
    }
  }
}
