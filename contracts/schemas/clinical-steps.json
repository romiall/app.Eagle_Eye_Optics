{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eeo.invalid/contracts/schemas/clinical-steps.json",
  "title": "Rubriques cliniques du dossier (modèle DP)",
  "description": "Valeurs non mesurées à null (jamais zéro par défaut), mesures en chaînes décimales exactes, termes du référentiel clinical_terms. Généré par contracts/tools/build_commands.py : ne pas modifier à la main.",
  "$defs": {
    "Anamnesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symptoms",
        "wears_glasses",
        "glasses_duration",
        "previous_correction_available",
        "complaints"
      ],
      "properties": {
        "symptoms": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4000
            },
            {
              "type": "null"
            }
          ]
        },
        "wears_glasses": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "glasses_duration": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4000
            },
            {
              "type": "null"
            }
          ]
        },
        "previous_correction_available": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "complaints": {
          "type": "array",
          "minItems": 0,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "term_code",
              "other_text"
            ],
            "properties": {
              "id": {
                "$ref": "common.json#/$defs/Ulid"
              },
              "term_code": {
                "$ref": "common.json#/$defs/Code"
              },
              "other_text": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 4000
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "Histories": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "histories"
      ],
      "properties": {
        "histories": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "history_group",
              "known_none",
              "comments",
              "terms"
            ],
            "properties": {
              "id": {
                "$ref": "common.json#/$defs/Ulid"
              },
              "history_group": {
                "$ref": "enums.json#/$defs/consultation_histories.history_group"
              },
              "known_none": {
                "type": "boolean"
              },
              "comments": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 4000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "terms": {
                "type": "array",
                "minItems": 0,
                "maxItems": 50,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "term_code",
                    "other_text"
                  ],
                  "properties": {
                    "id": {
                      "$ref": "common.json#/$defs/Ulid"
                    },
                    "term_code": {
                      "$ref": "common.json#/$defs/Code"
                    },
                    "other_text": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 4000
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "VisualAcuity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acuities"
      ],
      "properties": {
        "acuities": {
          "type": "array",
          "minItems": 0,
          "maxItems": 48,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "context",
              "distance",
              "correction",
              "eye",
              "scale_id",
              "raw_value",
              "normalized_value"
            ],
            "properties": {
              "id": {
                "$ref": "common.json#/$defs/Ulid"
              },
              "context": {
                "$ref": "enums.json#/$defs/visual_acuities.context"
              },
              "distance": {
                "$ref": "enums.json#/$defs/visual_acuities.distance"
              },
              "correction": {
                "$ref": "enums.json#/$defs/visual_acuities.correction"
              },
              "eye": {
                "$ref": "enums.json#/$defs/visual_acuities.eye"
              },
              "scale_id": {
                "$ref": "common.json#/$defs/Ulid"
              },
              "raw_value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "normalized_value": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^-?[0-9]{1,4}(\\.[0-9]{1,4})?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "Refraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurements",
        "refraction_observations",
        "ametropias"
      ],
      "properties": {
        "measurements": {
          "type": "array",
          "minItems": 0,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "stage",
              "eye",
              "sphere",
              "cylinder",
              "axis",
              "addition"
            ],
            "properties": {
              "id": {
                "$ref": "common.json#/$defs/Ulid"
              },
              "stage": {
                "$ref": "enums.json#/$defs/refraction_measurements.stage"
              },
              "eye": {
                "$ref": "enums.json#/$defs/refraction_measurements.eye"
              },
              "sphere": {
                "$ref": "common.json#/$defs/NullableDiopter"
              },
              "cylinder": {
                "$ref": "common.json#/$defs/NullableDiopter"
              },
              "axis": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 180
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "addition": {
                "$ref": "common.json#/$defs/NullableDiopter"
              }
            }
          }
        },
        "refraction_observations": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4000
            },
            {
              "type": "null"
            }
          ]
        },
        "ametropias": {
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "term_code",
              "other_text"
            ],
            "properties": {
              "id": {
                "$ref": "common.json#/$defs/Ulid"
              },
              "term_code": {
                "$ref": "common.json#/$defs/Code"
              },
              "other_text": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 4000
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "Centering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "centering_id",
        "pd_total",
        "pd_od",
        "pd_og",
        "inconsistency_reason"
      ],
      "properties": {
        "centering_id": {
          "$ref": "common.json#/$defs/NullableUlid"
        },
        "pd_total": {
          "$ref": "common.json#/$defs/NullableDiopter"
        },
        "pd_od": {
          "$ref": "common.json#/$defs/NullableDiopter"
        },
        "pd_og": {
          "$ref": "common.json#/$defs/NullableDiopter"
        },
        "inconsistency_reason": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4000
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Medications": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orders"
      ],
      "properties": {
        "orders": {
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "catalog_item_id",
              "name",
              "form",
              "form_other",
              "strength",
              "dosage",
              "frequency",
              "duration_text",
              "duration_value",
              "duration_unit",
              "instructions"
            ],
            "properties": {
              "id": {
                "$ref": "common.json#/$defs/Ulid"
              },
              "catalog_item_id": {
                "$ref": "common.json#/$defs/NullableUlid"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 180
              },
              "form": {
                "$ref": "enums.json#/$defs/medication_orders.form"
              },
              "form_other": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "strength": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "dosage": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 4000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "frequency": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 180
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "duration_text": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 180
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "duration_value": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4294967295
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "duration_unit": {
                "anyOf": [
                  {
                    "$ref": "enums.json#/$defs/medication_orders.duration_unit"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "instructions": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 4000
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "Conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conclusion",
        "referral",
        "referral_urgency",
        "referral_reasons"
      ],
      "properties": {
        "conclusion": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4000
            },
            {
              "type": "null"
            }
          ]
        },
        "referral": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "referral_urgency": {
          "anyOf": [
            {
              "$ref": "enums.json#/$defs/consultations.referral_urgency"
            },
            {
              "type": "null"
            }
          ]
        },
        "referral_reasons": {
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "term_code",
              "other_text"
            ],
            "properties": {
              "id": {
                "$ref": "common.json#/$defs/Ulid"
              },
              "term_code": {
                "$ref": "common.json#/$defs/Code"
              },
              "other_text": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 4000
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "StepName": {
      "type": "string",
      "enum": [
        "ANAMNESIS",
        "HISTORIES",
        "VISUAL_ACUITY",
        "REFRACTION",
        "CENTERING",
        "MEDICATIONS",
        "CONCLUSION"
      ]
    },
    "AllSteps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ANAMNESIS",
        "HISTORIES",
        "VISUAL_ACUITY",
        "REFRACTION",
        "CENTERING",
        "MEDICATIONS",
        "CONCLUSION"
      ],
      "properties": {
        "ANAMNESIS": {
          "$ref": "#/$defs/Anamnesis"
        },
        "HISTORIES": {
          "$ref": "#/$defs/Histories"
        },
        "VISUAL_ACUITY": {
          "$ref": "#/$defs/VisualAcuity"
        },
        "REFRACTION": {
          "$ref": "#/$defs/Refraction"
        },
        "CENTERING": {
          "$ref": "#/$defs/Centering"
        },
        "MEDICATIONS": {
          "$ref": "#/$defs/Medications"
        },
        "CONCLUSION": {
          "$ref": "#/$defs/Conclusion"
        }
      }
    }
  }
}
