{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eeo.invalid/contracts/schemas/error.json",
  "title": "Enveloppe d'erreur de l'API (fichier 08)",
  "description": "Code stable, message en français, erreurs par champ éventuelles, identifiant de corrélation. Jamais de trace ni de secret.",
  "type": "object",
  "additionalProperties": false,
  "required": ["error", "correlation_id"],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "#/$defs/ErrorCode" },
        "message": { "type": "string", "minLength": 1 },
        "fields": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "details": {
          "description": "Valeurs actualisées d'un refus d'état, à proposer au client (fichier 08 : « solde actualisé » de PAYMENT_EXCEEDS_BALANCE, « quantité disponible actualisée » de STOCK_UNAVAILABLE). Valeurs simples seulement, jamais une donnée personnelle ni clinique.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": ["string", "integer", "null"] }
        }
      }
    },
    "correlation_id": { "type": "string", "minLength": 8, "maxLength": 100 }
  },
  "$defs": {
    "ErrorCode": {
      "description": "Codes du fichier 08 et compléments documentés (F05). Un nouveau code s'ajoute ici avec sa route.",
      "type": "string",
      "enum": [
        "AUTH_REQUIRED",
        "SESSION_CONTEXT_EXPIRED",
        "SESSION_REQUIRED",
        "ACTION_FORBIDDEN",
        "RESOURCE_NOT_FOUND",
        "METHOD_NOT_ALLOWED",
        "VERSION_CONFLICT",
        "PAYMENT_EXCEEDS_BALANCE",
        "STOCK_UNAVAILABLE",
        "IDEMPOTENCY_PAYLOAD_MISMATCH",
        "SLOT_UNAVAILABLE",
        "VALIDATION_FAILED",
        "EXAM_PAYMENT_REQUIRED",
        "APPROVAL_REQUIRED_OR_EXPIRED",
        "REAUTHENTICATION_REQUIRED",
        "LOT_EXPIRED",
        "RATE_LIMITED",
        "DEPENDENCY_UNAVAILABLE",
        "CLINIC_NOT_CONFIGURED",
        "CLINIC_ALREADY_SET_UP",
        "LAST_MANAGER_REQUIRED",
        "MANAGER_RESET_REQUIRES_CONSOLE",
        "SELF_DEACTIVATION_FORBIDDEN",
        "SELF_OVERRIDE_FORBIDDEN",
        "SELF_RESET_FORBIDDEN",
        "SELF_ROLE_CHANGE_FORBIDDEN",
        "WRITE_OWNER_REQUIRED",
        "NUMBER_RANGE_EXHAUSTED",
        "GRANT_EXPIRED_OR_REVOKED",
        "AUTHORIZATION_REVIEW_REQUIRED",
        "SERVER_BUSY",
        "HTTP_ERROR",
        "INTERNAL_ERROR"
      ]
    }
  }
}
