{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eeo.invalid/contracts/schemas/resources/access.json",
  "title": "Ressources : session, comptes et cabinet",
  "description": "Réponses des routes F05 (implémentées). Généré par contracts/tools/build_resources.py : ne pas modifier à la main.",
  "$defs": {
    "StaffMemberSummary": {
      "description": "Compte dans une liste : sans les permissions effectives.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "login",
        "display_name",
        "email",
        "active",
        "version",
        "roles"
      ],
      "properties": {
        "id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "login": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "email": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 254
            },
            {
              "type": "null"
            }
          ]
        },
        "active": {
          "type": "boolean"
        },
        "version": {
          "$ref": "../../schemas/common.json#/$defs/Version"
        },
        "roles": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "enum": [
              "CASHIER",
              "CLINICIAN",
              "MANAGER",
              "RECEPTION"
            ]
          },
          "maxItems": 4
        }
      }
    },
    "StaffMember": {
      "description": "Compte du personnel : profils actifs et permissions effectives (jamais de hash ni de secret MFA).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "login",
        "display_name",
        "email",
        "active",
        "version",
        "roles",
        "permissions"
      ],
      "properties": {
        "id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "login": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "email": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 254
            },
            {
              "type": "null"
            }
          ]
        },
        "active": {
          "type": "boolean"
        },
        "version": {
          "$ref": "../../schemas/common.json#/$defs/Version"
        },
        "roles": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "enum": [
              "CASHIER",
              "CLINICIAN",
              "MANAGER",
              "RECEPTION"
            ]
          },
          "maxItems": 4
        },
        "permissions": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "../../schemas/common.json#/$defs/PermissionCode"
          }
        }
      }
    },
    "ClinicSummary": {
      "description": "enabled_modules : modules ouverts par l'exploitant (EEO_ENABLED_MODULES), codes de la navigation ; vide = aucun module métier exposé. exam_fee_control : OFF (défaut, le paiement de l'examen n'est contrôlé nulle part) ou BILLED (EEO_EXAM_FEE_CONTROL=billed : facture de frais réglée ou dispense de la gérante exigée au démarrage de l'examen) ; absent pour un serveur plus ancien, lu comme OFF.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "timezone",
        "currency",
        "production_documents_enabled",
        "enabled_modules"
      ],
      "properties": {
        "id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "currency": {
          "$ref": "../../schemas/common.json#/$defs/Currency"
        },
        "production_documents_enabled": {
          "type": "boolean"
        },
        "enabled_modules": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          }
        },
        "exam_fee_control": {
          "type": "string",
          "enum": [
            "OFF",
            "BILLED"
          ]
        }
      }
    },
    "Me": {
      "description": "Compte connecté : profils, permissions effectives, cabinet (nom, fuseau, monnaie).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "login",
        "display_name",
        "email",
        "active",
        "version",
        "roles",
        "permissions",
        "clinic"
      ],
      "properties": {
        "id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "login": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "email": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 254
            },
            {
              "type": "null"
            }
          ]
        },
        "active": {
          "type": "boolean"
        },
        "version": {
          "$ref": "../../schemas/common.json#/$defs/Version"
        },
        "roles": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "enum": [
              "CASHIER",
              "CLINICIAN",
              "MANAGER",
              "RECEPTION"
            ]
          },
          "maxItems": 4
        },
        "permissions": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "../../schemas/common.json#/$defs/PermissionCode"
          }
        },
        "clinic": {
          "$ref": "#/$defs/ClinicSummary"
        }
      }
    },
    "ClinicSettings": {
      "description": "Paramètres administratifs du cabinet (gérante).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "timezone",
        "currency",
        "address",
        "phone",
        "email",
        "tax_identifier",
        "professional_mentions",
        "document_settings",
        "production_documents_enabled"
      ],
      "properties": {
        "id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "currency": {
          "$ref": "../../schemas/common.json#/$defs/Currency"
        },
        "address": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "phone": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 32
            },
            {
              "type": "null"
            }
          ]
        },
        "email": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 254
            },
            {
              "type": "null"
            }
          ]
        },
        "tax_identifier": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "professional_mentions": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 4000
            },
            {
              "type": "null"
            }
          ]
        },
        "document_settings": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "production_documents_enabled": {
          "type": "boolean"
        }
      }
    },
    "ClinicDocumentIdentity": {
      "description": "Identité du cabinet imprimée sur les documents (en-tête, pied) : lisible par tout profil qui produit un document. production_documents_enabled faux : documents de TEST marqués comme tels.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "timezone",
        "currency",
        "address",
        "phone",
        "email",
        "tax_identifier",
        "professional_mentions",
        "document_settings",
        "production_documents_enabled"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "currency": {
          "$ref": "../../schemas/common.json#/$defs/Currency"
        },
        "address": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "phone": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 32
            },
            {
              "type": "null"
            }
          ]
        },
        "email": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 254
            },
            {
              "type": "null"
            }
          ]
        },
        "tax_identifier": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "professional_mentions": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 4000
            },
            {
              "type": "null"
            }
          ]
        },
        "document_settings": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "production_documents_enabled": {
          "type": "boolean"
        }
      }
    },
    "ClinicDocumentIdentityResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "$ref": "#/$defs/ClinicDocumentIdentity"
        }
      }
    },
    "Reauthentication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reauthenticated_until"
      ],
      "properties": {
        "reauthenticated_until": {
          "$ref": "../../schemas/common.json#/$defs/Instant"
        }
      }
    },
    "StaffMemberResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "$ref": "#/$defs/StaffMember"
        }
      }
    },
    "StaffMemberPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "meta"
      ],
      "properties": {
        "data": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/StaffMemberSummary"
          }
        },
        "meta": {
          "$ref": "../../schemas/common.json#/$defs/Pagination"
        }
      }
    },
    "MeResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "$ref": "#/$defs/Me"
        }
      }
    },
    "ClinicSettingsResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "$ref": "#/$defs/ClinicSettings"
        }
      }
    },
    "ReauthenticationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "$ref": "#/$defs/Reauthentication"
        }
      }
    }
  }
}
