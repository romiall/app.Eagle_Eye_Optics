{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eeo.invalid/contracts/schemas/resources/patients.json",
  "title": "Ressources : patients et visites",
  "description": "Identité administrative, historique filtré par profil, visites. Généré par contracts/tools/build_resources.py : ne pas modifier à la main.",
  "$defs": {
    "PatientSummary": {
      "description": "Résultat de recherche : identité administrative minimale (tous profils autorisés).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "record_number",
        "last_name",
        "first_names",
        "sex",
        "birth_date",
        "phone_primary",
        "archived",
        "merged_into_patient_id",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "record_number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "last_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "first_names": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 180
            },
            {
              "type": "null"
            }
          ]
        },
        "sex": {
          "$ref": "../../schemas/enums.json#/$defs/patient_records.sex"
        },
        "birth_date": {
          "$ref": "../../schemas/common.json#/$defs/NullableCivilDate"
        },
        "phone_primary": {
          "anyOf": [
            {
              "$ref": "../../schemas/common.json#/$defs/Phone"
            },
            {
              "type": "null"
            }
          ]
        },
        "archived": {
          "type": "boolean"
        },
        "merged_into_patient_id": {
          "$ref": "../../schemas/common.json#/$defs/NullableUlid"
        },
        "version": {
          "$ref": "../../schemas/common.json#/$defs/Version"
        }
      }
    },
    "Patient": {
      "description": "Dossier administratif (identité durable) ; jamais de donnée clinique. merged_records (lecture GET /patients/{id} seulement) : fiches fusionnées dans celle-ci (L1D08), de la plus ancienne fusion à la plus récente.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "record_number",
        "last_name",
        "first_names",
        "sex",
        "birth_date",
        "phone_primary",
        "archived",
        "merged_into_patient_id",
        "version",
        "birth_date_missing_reason",
        "phone_secondary",
        "phone_missing_reason",
        "address",
        "profession",
        "guardian_contact",
        "legacy_record",
        "first_known_visit_on",
        "first_visit_certified",
        "legacy_record_number",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "record_number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "last_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "first_names": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 180
            },
            {
              "type": "null"
            }
          ]
        },
        "sex": {
          "$ref": "../../schemas/enums.json#/$defs/patient_records.sex"
        },
        "birth_date": {
          "$ref": "../../schemas/common.json#/$defs/NullableCivilDate"
        },
        "phone_primary": {
          "anyOf": [
            {
              "$ref": "../../schemas/common.json#/$defs/Phone"
            },
            {
              "type": "null"
            }
          ]
        },
        "archived": {
          "type": "boolean"
        },
        "merged_into_patient_id": {
          "$ref": "../../schemas/common.json#/$defs/NullableUlid"
        },
        "version": {
          "$ref": "../../schemas/common.json#/$defs/Version"
        },
        "birth_date_missing_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "phone_secondary": {
          "anyOf": [
            {
              "$ref": "../../schemas/common.json#/$defs/Phone"
            },
            {
              "type": "null"
            }
          ]
        },
        "phone_missing_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "address": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "profession": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 180
            },
            {
              "type": "null"
            }
          ]
        },
        "guardian_contact": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "legacy_record": {
          "type": "boolean"
        },
        "first_known_visit_on": {
          "$ref": "../../schemas/common.json#/$defs/NullableCivilDate"
        },
        "first_visit_certified": {
          "type": "boolean"
        },
        "legacy_record_number": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "$ref": "../../schemas/common.json#/$defs/Instant"
        },
        "updated_at": {
          "$ref": "../../schemas/common.json#/$defs/Instant"
        },
        "merged_records": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "patient_id",
              "record_number",
              "merged_at"
            ],
            "properties": {
              "patient_id": {
                "$ref": "../../schemas/common.json#/$defs/Ulid"
              },
              "record_number": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "merged_at": {
                "$ref": "../../schemas/common.json#/$defs/Instant"
              }
            }
          }
        }
      }
    },
    "PatientHistory": {
      "description": "Historique : visites pour tout profil autorisé ; consultations seulement avec clinical.read ; pièces seulement avec invoice.read.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patient_id",
        "visits"
      ],
      "properties": {
        "patient_id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "visits": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "reason",
              "occurred_at",
              "status"
            ],
            "properties": {
              "id": {
                "$ref": "../../schemas/common.json#/$defs/Ulid"
              },
              "reason": {
                "$ref": "../../schemas/enums.json#/$defs/visits.reason"
              },
              "occurred_at": {
                "$ref": "../../schemas/common.json#/$defs/Instant"
              },
              "status": {
                "$ref": "../../schemas/enums.json#/$defs/visits.status"
              }
            }
          }
        },
        "consultations": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "visit_id",
              "effective_at",
              "status",
              "current_revision",
              "clinician_id"
            ],
            "properties": {
              "id": {
                "$ref": "../../schemas/common.json#/$defs/Ulid"
              },
              "visit_id": {
                "$ref": "../../schemas/common.json#/$defs/Ulid"
              },
              "effective_at": {
                "$ref": "../../schemas/common.json#/$defs/Instant"
              },
              "status": {
                "$ref": "../../schemas/enums.json#/$defs/consultations.status"
              },
              "current_revision": {
                "type": "integer",
                "minimum": 0
              },
              "clinician_id": {
                "$ref": "../../schemas/common.json#/$defs/Ulid"
              }
            }
          }
        },
        "invoices": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "number",
              "status",
              "issued_at",
              "total_gross",
              "balance_due"
            ],
            "properties": {
              "id": {
                "$ref": "../../schemas/common.json#/$defs/Ulid"
              },
              "number": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 64
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "$ref": "../../schemas/enums.json#/$defs/invoices.status"
              },
              "issued_at": {
                "$ref": "../../schemas/common.json#/$defs/NullableInstant"
              },
              "total_gross": {
                "$ref": "../../schemas/common.json#/$defs/MoneyXaf"
              },
              "balance_due": {
                "$ref": "../../schemas/common.json#/$defs/SignedMoneyXaf"
              }
            }
          }
        }
      }
    },
    "PatientResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "$ref": "#/$defs/Patient"
        }
      }
    },
    "PatientPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "meta"
      ],
      "properties": {
        "data": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/PatientSummary"
          }
        },
        "meta": {
          "$ref": "../../schemas/common.json#/$defs/Pagination"
        }
      }
    },
    "PatientHistoryResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "$ref": "#/$defs/PatientHistory"
        }
      }
    },
    "Visit": {
      "description": "Visite : l’identité de base du patient accompagne la visite (file du jour). exam_fee_control, contrôle inactif (EEO_EXAM_FEE_CONTROL=off, défaut) : NOT_CONTROLLED pour un motif d’examen ou de suivi, NOT_APPLICABLE pour un achat ou un retrait ; contrôle actif (billed) : UNPAID (frais d’examen à encaisser), WAIVER_REQUESTED (dispense demandée, en attente de la gérante), PAID (facture de frais de CETTE visite réglée ; exam_fee_receipt_number = numéro de son dernier reçu), WAIVED (dispense accordée ou consommée), NOT_APPLICABLE. Jamais « payé » ni « gratuit » sans pièce : PAID s’appuie sur des reçus réels. Contrôle actif, le statut AWAITING_EXAM_FEE / READY_FOR_EXAM est celui du contrôle à l’instant (une dispense échue ramène « en attente »). consultation_id et consultation_status : la consultation de la visite, rendus SEULEMENT à un compte qui détient clinical.read (null sinon, y compris quand la consultation existe) ; null aussi quand l’examen n’est pas démarré.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "patient_id",
        "reason",
        "occurred_at",
        "status",
        "appointment_id",
        "exam_invoice_id",
        "exam_waiver_approval_id",
        "arrival_at",
        "closed_at",
        "administrative_note",
        "version",
        "patient",
        "exam_fee_control",
        "consultation_id",
        "consultation_status"
      ],
      "properties": {
        "id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "patient_id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "reason": {
          "$ref": "../../schemas/enums.json#/$defs/visits.reason"
        },
        "occurred_at": {
          "$ref": "../../schemas/common.json#/$defs/Instant"
        },
        "status": {
          "$ref": "../../schemas/enums.json#/$defs/visits.status"
        },
        "appointment_id": {
          "$ref": "../../schemas/common.json#/$defs/NullableUlid"
        },
        "exam_invoice_id": {
          "$ref": "../../schemas/common.json#/$defs/NullableUlid"
        },
        "exam_waiver_approval_id": {
          "$ref": "../../schemas/common.json#/$defs/NullableUlid"
        },
        "arrival_at": {
          "$ref": "../../schemas/common.json#/$defs/NullableInstant"
        },
        "closed_at": {
          "$ref": "../../schemas/common.json#/$defs/NullableInstant"
        },
        "administrative_note": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "$ref": "../../schemas/common.json#/$defs/Version"
        },
        "patient": {
          "$ref": "#/$defs/VisitPatient"
        },
        "exam_fee_control": {
          "type": "string",
          "enum": [
            "NOT_CONTROLLED",
            "NOT_APPLICABLE",
            "UNPAID",
            "WAIVER_REQUESTED",
            "PAID",
            "WAIVED"
          ]
        },
        "exam_fee_receipt_number": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "consultation_id": {
          "$ref": "../../schemas/common.json#/$defs/NullableUlid"
        },
        "consultation_status": {
          "anyOf": [
            {
              "$ref": "../../schemas/enums.json#/$defs/consultations.status"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "VisitPatient": {
      "description": "Identité administrative de base du patient d’une visite.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "record_number",
        "last_name",
        "first_names",
        "sex",
        "birth_date"
      ],
      "properties": {
        "id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "record_number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "last_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "first_names": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 180
            },
            {
              "type": "null"
            }
          ]
        },
        "sex": {
          "$ref": "../../schemas/enums.json#/$defs/patient_records.sex"
        },
        "birth_date": {
          "$ref": "../../schemas/common.json#/$defs/NullableCivilDate"
        }
      }
    },
    "VisitResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "$ref": "#/$defs/Visit"
        }
      }
    },
    "VisitPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "meta"
      ],
      "properties": {
        "data": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/Visit"
          }
        },
        "meta": {
          "$ref": "../../schemas/common.json#/$defs/Pagination"
        }
      }
    },
    "PatientMergeIdentity": {
      "description": "Identité administrative comparée avant une fusion (L1D08) : jamais de donnée clinique.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "record_number",
        "last_name",
        "first_names",
        "sex",
        "birth_date",
        "phone_primary",
        "archived",
        "merged_into_patient_id",
        "version",
        "legacy_record_number",
        "created_at"
      ],
      "properties": {
        "id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "record_number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "last_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "first_names": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 180
            },
            {
              "type": "null"
            }
          ]
        },
        "sex": {
          "$ref": "../../schemas/enums.json#/$defs/patient_records.sex"
        },
        "birth_date": {
          "$ref": "../../schemas/common.json#/$defs/NullableCivilDate"
        },
        "phone_primary": {
          "anyOf": [
            {
              "$ref": "../../schemas/common.json#/$defs/Phone"
            },
            {
              "type": "null"
            }
          ]
        },
        "archived": {
          "type": "boolean"
        },
        "merged_into_patient_id": {
          "$ref": "../../schemas/common.json#/$defs/NullableUlid"
        },
        "version": {
          "$ref": "../../schemas/common.json#/$defs/Version"
        },
        "legacy_record_number": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "$ref": "../../schemas/common.json#/$defs/Instant"
        }
      }
    },
    "PatientMergePreview": {
      "description": "Aperçu d'une fusion : les deux identités côte à côte, ce qui est rattaché à la fiche absorbée (visites pour tout compte autorisé ; consultations et prescriptions seulement avec clinical.read, pièces émises seulement avec invoice.read, null sinon) et les garde-fous qui empêchent la fusion.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "survivor",
        "linked",
        "blockers",
        "can_merge"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/PatientMergeIdentity"
        },
        "survivor": {
          "$ref": "#/$defs/PatientMergeIdentity"
        },
        "linked": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "visits",
            "appointments_upcoming",
            "consultations",
            "prescriptions",
            "invoices"
          ],
          "properties": {
            "visits": {
              "type": "integer",
              "minimum": 0
            },
            "appointments_upcoming": {
              "type": "integer",
              "minimum": 0
            },
            "consultations": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "prescriptions": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "invoices": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "blockers": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "SOURCE_ALREADY_MERGED",
                  "SURVIVOR_MERGED",
                  "SURVIVOR_ARCHIVED",
                  "VISIT_IN_PROGRESS",
                  "CONSULTATION_IN_PROGRESS",
                  "INVOICE_DRAFT",
                  "APPOINTMENT_UPCOMING"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            }
          }
        },
        "can_merge": {
          "type": "boolean"
        }
      }
    },
    "PatientMergePreviewResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "$ref": "#/$defs/PatientMergePreview"
        }
      }
    },
    "PatientMerge": {
      "description": "Fusion enregistrée (patient_merges, immuable) : la fiche absorbée garde son identifiant, son numéro et son historique ; elle pointe vers la fiche conservée.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_patient_id",
        "survivor_patient_id",
        "approved_by",
        "merged_at",
        "reason",
        "source_version"
      ],
      "properties": {
        "id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "source_patient_id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "survivor_patient_id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "approved_by": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "merged_at": {
          "$ref": "../../schemas/common.json#/$defs/Instant"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "source_version": {
          "$ref": "../../schemas/common.json#/$defs/Version"
        }
      }
    },
    "PatientMergeResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "$ref": "#/$defs/PatientMerge"
        }
      }
    },
    "PatientActivityVisit": {
      "description": "Visite (section VISITS, patient.read) : motif et statut administratifs ; occurred_at = heure de la visite.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "occurred_at",
        "screen_path",
        "reason",
        "status"
      ],
      "properties": {
        "type": {
          "const": "VISIT"
        },
        "id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "occurred_at": {
          "$ref": "../../schemas/common.json#/$defs/Instant"
        },
        "screen_path": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^/[A-Za-z0-9/_-]{1,199}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "$ref": "../../schemas/enums.json#/$defs/visits.reason"
        },
        "status": {
