{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eeo.invalid/contracts/schemas/resources/scheduling.json",
  "title": "Ressources : suivi, agenda et tâches de contact",
  "description": "Agenda interne, contrôles recommandés et relances (L0 sans envoi externe). Généré par contracts/tools/build_resources.py : ne pas modifier à la main.",
  "$defs": {
    "SchedulingPatient": {
      "description": "Identité administrative minimale du patient d'un rendez-vous, d'un suivi ou d'une tâche.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "record_number",
        "last_name",
        "first_names"
      ],
      "properties": {
        "id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "record_number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "last_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "first_names": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 180
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "OpeningHour": {
      "description": "Créneau hebdomadaire d'une ressource (1 = lundi … 7 = dimanche), heure locale du cabinet.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "weekday",
        "opens_at",
        "closes_at",
        "valid_from",
        "valid_to"
      ],
      "properties": {
        "id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "weekday": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "opens_at": {
          "$ref": "../../schemas/common.json#/$defs/LocalTime"
        },
        "closes_at": {
          "$ref": "../../schemas/common.json#/$defs/LocalTime"
        },
        "valid_from": {
          "$ref": "../../schemas/common.json#/$defs/NullableCivilDate"
        },
        "valid_to": {
          "$ref": "../../schemas/common.json#/$defs/NullableCivilDate"
        }
      }
    },
    "SchedulingResource": {
      "description": "Professionnel ou salle réservable ; aucun horaire n'est inventé : sans créneau hebdomadaire, aucun rendez-vous n'est proposé.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "professional_user_id",
        "professional_name",
        "active",
        "slot_duration_minutes",
        "version",
        "opening_hours"
      ],
      "properties": {
        "id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "professional_user_id": {
          "$ref": "../../schemas/common.json#/$defs/NullableUlid"
        },
        "professional_name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 180
            },
            {
              "type": "null"
            }
          ]
        },
        "active": {
          "type": "boolean"
        },
        "slot_duration_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        },
        "version": {
          "$ref": "../../schemas/common.json#/$defs/Version"
        },
        "opening_hours": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/OpeningHour"
          }
        }
      }
    },
    "SchedulingResourceResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "$ref": "#/$defs/SchedulingResource"
        }
      }
    },
    "AppointmentService": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "duration_minutes",
        "active",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "duration_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        },
        "active": {
          "type": "boolean"
        },
        "version": {
          "$ref": "../../schemas/common.json#/$defs/Version"
        }
      }
    },
    "AppointmentServiceResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "$ref": "#/$defs/AppointmentService"
        }
      }
    },
    "ResourceException": {
      "description": "Fermeture (is_available = false) ou ouverture exceptionnelle datée d'une ressource.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "resource_id",
        "starts_at",
        "ends_at",
        "is_available",
        "reason"
      ],
      "properties": {
        "id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "resource_id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "starts_at": {
          "$ref": "../../schemas/common.json#/$defs/Instant"
        },
        "ends_at": {
          "$ref": "../../schemas/common.json#/$defs/Instant"
        },
        "is_available": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "ResourceExceptionResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "$ref": "#/$defs/ResourceException"
        }
      }
    },
    "AgendaConfiguration": {
      "description": "Configuration de l'agenda (S01) : ressources, prestations, exceptions à venir (90 jours).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resources",
        "services",
        "exceptions"
      ],
      "properties": {
        "resources": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/SchedulingResource"
          }
        },
        "services": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/AppointmentService"
          }
        },
        "exceptions": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/ResourceException"
          }
        }
      }
    },
    "AgendaConfigurationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "$ref": "#/$defs/AgendaConfiguration"
        }
      }
    },
    "AvailableSlots": {
      "description": "Créneaux libres d'un jour civil du cabinet pour une ressource et une prestation, lus SOUS l'état du serveur au moment de la lecture : la réservation revérifie sous verrou.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "resource_id",
        "service_id",
        "duration_minutes",
        "slots"
      ],
      "properties": {
        "date": {
          "$ref": "../../schemas/common.json#/$defs/CivilDate"
        },
        "resource_id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "service_id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "duration_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        },
        "slots": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "starts_at",
              "ends_at"
            ],
            "properties": {
              "starts_at": {
                "$ref": "../../schemas/common.json#/$defs/Instant"
              },
              "ends_at": {
                "$ref": "../../schemas/common.json#/$defs/Instant"
              }
            }
          }
        }
      }
    },
    "AvailableSlotsResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "$ref": "#/$defs/AvailableSlots"
        }
      }
    },
    "FollowUpPlan": {
      "description": "Contrôle recommandé (S02), jamais une réservation implicite. reason, manual_reason et notes valent null pour un compte sans clinical.read (cloisonnement clinique) ; la date et l'identité restent lisibles par l'agenda.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "consultation_id",
        "patient_id",
        "patient",
        "reason",
        "anchor_kind",
        "anchor_date",
        "interval_value",
        "interval_unit",
        "recommended_date",
        "date_origin",
        "manual_reason",
        "reminder_enabled",
        "preferred_channel",
        "advance_value",
        "advance_unit",
        "reminder_date",
        "notes",
        "status",
        "appointment_id",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "consultation_id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "patient_id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "patient": {
          "$ref": "#/$defs/SchedulingPatient"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "../../schemas/enums.json#/$defs/follow_up_plans.reason"
            },
            {
              "type": "null"
            }
          ]
        },
        "anchor_kind": {
          "$ref": "../../schemas/enums.json#/$defs/follow_up_plans.anchor_kind"
        },
        "anchor_date": {
          "$ref": "../../schemas/common.json#/$defs/CivilDate"
        },
        "interval_value": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "interval_unit": {
          "anyOf": [
            {
              "$ref": "../../schemas/enums.json#/$defs/follow_up_plans.interval_unit"
            },
            {
              "type": "null"
            }
          ]
        },
        "recommended_date": {
          "$ref": "../../schemas/common.json#/$defs/CivilDate"
        },
        "date_origin": {
          "$ref": "../../schemas/enums.json#/$defs/follow_up_plans.date_origin"
        },
        "manual_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "reminder_enabled": {
          "type": "boolean"
        },
        "preferred_channel": {
          "$ref": "../../schemas/enums.json#/$defs/follow_up_plans.preferred_channel"
        },
        "advance_value": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "advance_unit": {
          "anyOf": [
            {
              "$ref": "../../schemas/enums.json#/$defs/follow_up_plans.advance_unit"
            },
            {
              "type": "null"
            }
          ]
        },
        "reminder_date": {
          "$ref": "../../schemas/common.json#/$defs/NullableCivilDate"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "../../schemas/enums.json#/$defs/follow_up_plans.status"
        },
        "appointment_id": {
          "$ref": "../../schemas/common.json#/$defs/NullableUlid"
        },
        "version": {
          "$ref": "../../schemas/common.json#/$defs/Version"
        }
      }
    },
    "FollowUpPlanResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "$ref": "#/$defs/FollowUpPlan"
        }
      }
    },
    "FollowUpPlanList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/FollowUpPlan"
          }
        }
      }
    },
    "Appointment": {
      "description": "Rendez-vous ; un rendez-vous pris hors-ligne reste PENDING_CONFIRMATION jusqu'à validation serveur. visit_id : arrivée enregistrée pour ce rendez-vous, s'il y en a une.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "patient_id",
        "patient",
        "prospect_contact_id",
        "follow_up_id",
        "resource_id",
        "resource_name",
        "service_id",
        "service_name",
        "starts_at",
        "ends_at",
        "status",
        "source",
        "administrative_reason",
        "cancel_reason",
        "visit_id",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "patient_id": {
          "$ref": "../../schemas/common.json#/$defs/NullableUlid"
        },
        "patient": {
          "anyOf": [
            {
              "$ref": "#/$defs/SchedulingPatient"
            },
            {
              "type": "null"
            }
          ]
        },
        "prospect_contact_id": {
          "$ref": "../../schemas/common.json#/$defs/NullableUlid"
        },
        "follow_up_id": {
          "$ref": "../../schemas/common.json#/$defs/NullableUlid"
        },
        "resource_id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "resource_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "service_id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "service_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "starts_at": {
          "$ref": "../../schemas/common.json#/$defs/Instant"
        },
        "ends_at": {
          "$ref": "../../schemas/common.json#/$defs/Instant"
        },
        "status": {
          "$ref": "../../schemas/enums.json#/$defs/appointments.status"
        },
        "source": {
          "$ref": "../../schemas/enums.json#/$defs/appointments.source"
        },
        "administrative_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "cancel_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "visit_id": {
          "$ref": "../../schemas/common.json#/$defs/NullableUlid"
        },
        "version": {
          "$ref": "../../schemas/common.json#/$defs/Version"
        }
      }
    },
    "AppointmentResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "$ref": "#/$defs/Appointment"
        }
      }
    },
    "AppointmentList": {
      "description": "Rendez-vous d'une période de jours civils du cabinet (31 jours au plus), du plus tôt au plus tard.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/Appointment"
          }
        }
      }
    },
    "ContactAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "occurred_at",
        "result",
        "actor_name",
        "administrative_note"
      ],
      "properties": {
        "id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "occurred_at": {
          "$ref": "../../schemas/common.json#/$defs/Instant"
        },
        "result": {
          "$ref": "../../schemas/enums.json#/$defs/contact_attempts.result"
        },
        "actor_name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 180
            },
            {
              "type": "null"
            }
          ]
        },
        "administrative_note": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ContactTask": {
      "description": "Tâche de contact INTERNE (L0 : aucun envoi SMS/WhatsApp réel ; le canal est la préférence du patient). Unique par source et échéance (dedupe_key) : jamais deux relances pour le même événement.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "patient_id",
        "patient",
        "prospect_contact_id",
        "follow_up_id",
        "appointment_id",
        "invoice_id",
        "source_type",
        "source_date",
        "source_starts_at",
        "due_at",
        "channel",
        "status",
        "next_attempt_at",
        "assigned_to",
        "administrative_notes",
        "attempts",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "patient_id": {
          "$ref": "../../schemas/common.json#/$defs/NullableUlid"
        },
        "patient": {
          "anyOf": [
            {
              "$ref": "#/$defs/SchedulingPatient"
            },
            {
              "type": "null"
            }
          ]
        },
        "prospect_contact_id": {
          "$ref": "../../schemas/common.json#/$defs/NullableUlid"
        },
        "follow_up_id": {
          "$ref": "../../schemas/common.json#/$defs/NullableUlid"
        },
        "appointment_id": {
          "$ref": "../../schemas/common.json#/$defs/NullableUlid"
        },
        "invoice_id": {
          "$ref": "../../schemas/common.json#/$defs/NullableUlid"
        },
        "source_type": {
          "type": "string",
          "enum": [
            "FOLLOW_UP",
            "APPOINTMENT",
            "INVOICE",
            "WORKSHOP_ORDER"
          ]
        },
        "source_date": {
          "$ref": "../../schemas/common.json#/$defs/NullableCivilDate"
        },
        "source_starts_at": {
          "$ref": "../../schemas/common.json#/$defs/NullableInstant"
        },
        "due_at": {
          "$ref": "../../schemas/common.json#/$defs/Instant"
        },
        "channel": {
          "$ref": "../../schemas/enums.json#/$defs/contact_tasks.channel"
        },
        "status": {
          "$ref": "../../schemas/enums.json#/$defs/contact_tasks.status"
        },
        "next_attempt_at": {
          "$ref": "../../schemas/common.json#/$defs/NullableInstant"
        },
        "assigned_to": {
          "$ref": "../../schemas/common.json#/$defs/NullableUlid"
        },
        "administrative_notes": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "attempts": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/ContactAttempt"
          }
        },
        "version": {
          "$ref": "../../schemas/common.json#/$defs/Version"
        }
      }
    },
    "ContactTaskPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "meta"
      ],
      "properties": {
        "data": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/ContactTask"
          }
        },
        "meta": {
          "$ref": "../../schemas/common.json#/$defs/Pagination"
        }
      }
    },
    "ContactTaskList": {
      "description": "Tâches de contact d'un jour civil du cabinet (échéance ou nouvelle tentative ce jour-là, ou en retard et encore ouvertes).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/ContactTask"
          }
        }
      }
    },
    "ContactAttemptResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "task"
      ],
      "properties": {
        "attempt_id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "task": {
          "$ref": "#/$defs/ContactTask"
        }
      }
    },
    "ContactAttemptResultResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "$ref": "#/$defs/ContactAttemptResult"
        }
      }
    },
    "ActivityReport": {
      "description": "Activité administrative (R02, statistics.activity) sur une période de jours civils du cabinet : visites non annulées, patients distincts, nouveaux (première visite connue au cabinet dans la période, reprise historique comprise) et anciens, sexe et tranches d'âge des patients de la période (âge au dernier jour de la période). Comptages seulement, aucune donnée clinique ni financière. appointments et follow_ups_due valent null tant que l'agenda (S01, S02) n'est pas livré.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "timezone",
        "visits",
        "visits_by_reason",
        "patients",
        "new_patients",
        "returning_patients",
        "sex",
        "age_bands",
        "age_unknown",
        "appointments",
        "follow_ups_due"
      ],
      "properties": {
        "from": {
          "$ref": "../../schemas/common.json#/$defs/CivilDate"
        },
        "to": {
          "$ref": "../../schemas/common.json#/$defs/CivilDate"
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "visits": {
          "type": "integer",
          "minimum": 0
        },
        "visits_by_reason": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason",
              "count"
            ],
            "properties": {
              "reason": {
                "$ref": "../../schemas/enums.json#/$defs/visits.reason"
              },
