{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eeo.invalid/contracts/schemas/resources/clinical.json",
  "title": "Ressources : consultations et prescriptions",
  "description": "Données cliniques réservées aux profils autorisés (fichier 09). Généré par contracts/tools/build_resources.py : ne pas modifier à la main.",
  "$defs": {
    "ClinicalRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision_no",
        "recorded_at",
        "author_id",
        "reason",
        "previous_revision_id",
        "sha256"
      ],
      "properties": {
        "id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "revision_no": {
          "type": "integer",
          "minimum": 1
        },
        "recorded_at": {
          "$ref": "../../schemas/common.json#/$defs/Instant"
        },
        "author_id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "previous_revision_id": {
          "$ref": "../../schemas/common.json#/$defs/NullableUlid"
        },
        "sha256": {
          "$ref": "../../schemas/common.json#/$defs/Sha256Hex"
        }
      }
    },
    "ClinicalRevisionDetail": {
      "description": "Révision figée avec son snapshot complet (clinical.read) : immuable, lue telle qu’enregistrée ; sha256 = SHA-256 de JCS(snapshot).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision_no",
        "recorded_at",
        "author_id",
        "reason",
        "previous_revision_id",
        "sha256",
        "snapshot"
      ],
      "properties": {
        "id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "revision_no": {
          "type": "integer",
          "minimum": 1
        },
        "recorded_at": {
          "$ref": "../../schemas/common.json#/$defs/Instant"
        },
        "author_id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "previous_revision_id": {
          "$ref": "../../schemas/common.json#/$defs/NullableUlid"
        },
        "sha256": {
          "$ref": "../../schemas/common.json#/$defs/Sha256Hex"
        },
        "snapshot": {
          "$ref": "../../snapshots/clinical-revision.json"
        }
      }
    },
    "ClinicalRevisionResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "$ref": "#/$defs/ClinicalRevisionDetail"
        }
      }
    },
    "ConsultationPatient": {
      "description": "Identité administrative de base du patient de la consultation, pour l’en-tête de l’écran (comme Visit.patient).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "record_number",
        "last_name",
        "first_names",
        "sex",
        "birth_date"
      ],
      "properties": {
        "id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "record_number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "last_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "first_names": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 180
            },
            {
              "type": "null"
            }
          ]
        },
        "sex": {
          "$ref": "../../schemas/enums.json#/$defs/patient_records.sex"
        },
        "birth_date": {
          "$ref": "../../schemas/common.json#/$defs/NullableCivilDate"
        }
      }
    },
    "Consultation": {
      "description": "Consultation complète : professionnel et gérante seulement (clinical.read). patient : identité administrative de base, pour l’en-tête (sans dépendre du module Patients).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "visit_id",
        "patient_id",
        "clinician_id",
        "effective_at",
        "date_change_reason",
        "status",
        "current_revision",
        "completed_at",
        "finalization_missing_data_reason",
        "version",
        "patient",
        "steps",
        "revisions"
      ],
      "properties": {
        "id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "visit_id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "patient_id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "clinician_id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "effective_at": {
          "$ref": "../../schemas/common.json#/$defs/Instant"
        },
        "date_change_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "../../schemas/enums.json#/$defs/consultations.status"
        },
        "current_revision": {
          "type": "integer",
          "minimum": 0
        },
        "completed_at": {
          "$ref": "../../schemas/common.json#/$defs/NullableInstant"
        },
        "finalization_missing_data_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "$ref": "../../schemas/common.json#/$defs/Version"
        },
        "patient": {
          "$ref": "#/$defs/ConsultationPatient"
        },
        "steps": {
          "$ref": "../../schemas/clinical-steps.json#/$defs/AllSteps"
        },
        "revisions": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "revision_no",
              "recorded_at",
              "author_id",
              "reason",
              "previous_revision_id",
              "sha256"
            ],
            "properties": {
              "id": {
                "$ref": "../../schemas/common.json#/$defs/Ulid"
              },
              "revision_no": {
                "type": "integer",
                "minimum": 1
              },
              "recorded_at": {
                "$ref": "../../schemas/common.json#/$defs/Instant"
              },
              "author_id": {
                "$ref": "../../schemas/common.json#/$defs/Ulid"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "previous_revision_id": {
                "$ref": "../../schemas/common.json#/$defs/NullableUlid"
              },
              "sha256": {
                "$ref": "../../schemas/common.json#/$defs/Sha256Hex"
              }
            }
          }
        }
      }
    },
    "ConsultationSummary": {
      "description": "Examen dans la liste du cabinet : patient (identité administrative de base), état, dates, révision et professionnel. Aucune valeur clinique.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "visit_id",
        "patient_id",
        "status",
        "effective_at",
        "completed_at",
        "current_revision",
        "patient",
        "clinician"
      ],
      "properties": {
        "id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "visit_id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "patient_id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "status": {
          "$ref": "../../schemas/enums.json#/$defs/consultations.status"
        },
        "effective_at": {
          "$ref": "../../schemas/common.json#/$defs/Instant"
        },
        "completed_at": {
          "$ref": "../../schemas/common.json#/$defs/NullableInstant"
        },
        "current_revision": {
          "type": "integer",
          "minimum": 0
        },
        "patient": {
          "$ref": "#/$defs/ConsultationPatient"
        },
        "clinician": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "display_name"
          ],
          "properties": {
            "id": {
              "$ref": "../../schemas/common.json#/$defs/Ulid"
            },
            "display_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180
            }
          }
        }
      }
    },
    "ConsultationSummaryPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "meta"
      ],
      "properties": {
        "data": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/ConsultationSummary"
          }
        },
        "meta": {
          "$ref": "../../schemas/common.json#/$defs/Pagination"
        }
      }
    },
    "VisualAcuityScale": {
      "description": "Échelle d’acuité configurée par le cabinet (visual_acuity_scales). Aucune conversion entre échelles n’est fournie ni présumée.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "label",
        "description",
        "active"
      ],
      "properties": {
        "id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "description": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "active": {
          "type": "boolean"
        }
      }
    },
    "VisualAcuityScaleList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/VisualAcuityScale"
          }
        }
      }
    },
    "Prescription": {
      "description": "Prescription versionnée ; updated_at sert de jeton de concurrence pour PATCH d'un brouillon (optical_prescriptions n'a pas de colonne version).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "series_id",
        "version_no",
        "supersedes_id",
        "patient_id",
        "origin",
        "consultation_id",
        "external_prescriber",
        "external_prescribed_on",
        "external_file_id",
        "status",
        "usage_code",
        "usage_other",
        "lens_type_code",
        "lens_type_other",
        "lens_index",
        "lens_index_other",
        "pd_total",
        "pd_od",
        "pd_og",
        "pd_inconsistency_reason",
        "notes",
        "eyes",
        "treatments",
        "validated_at",
        "validated_by",
        "validated_by_name",
        "document_id",
        "updated_at"
      ],
      "properties": {
        "id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "series_id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "version_no": {
          "type": "integer",
          "minimum": 1
        },
        "supersedes_id": {
          "$ref": "../../schemas/common.json#/$defs/NullableUlid"
        },
        "patient_id": {
          "$ref": "../../schemas/common.json#/$defs/Ulid"
        },
        "origin": {
          "$ref": "../../schemas/enums.json#/$defs/optical_prescriptions.origin"
        },
        "consultation_id": {
          "$ref": "../../schemas/common.json#/$defs/NullableUlid"
        },
        "external_prescriber": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 180
            },
            {
              "type": "null"
            }
          ]
        },
        "external_prescribed_on": {
          "$ref": "../../schemas/common.json#/$defs/NullableCivilDate"
        },
        "external_file_id": {
          "$ref": "../../schemas/common.json#/$defs/NullableUlid"
        },
        "status": {
          "$ref": "../../schemas/enums.json#/$defs/optical_prescriptions.status"
        },
        "usage_code": {
          "anyOf": [
            {
              "$ref": "../../schemas/common.json#/$defs/Code"
            },
            {
              "type": "null"
            }
          ]
        },
        "usage_other": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "lens_type_code": {
          "anyOf": [
            {
              "$ref": "../../schemas/common.json#/$defs/Code"
            },
            {
              "type": "null"
            }
          ]
        },
        "lens_type_other": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "lens_index": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]\\.[0-9]{1,2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "lens_index_other": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "pd_total": {
          "$ref": "../../schemas/common.json#/$defs/NullableDiopter"
        },
        "pd_od": {
          "$ref": "../../schemas/common.json#/$defs/NullableDiopter"
        },
        "pd_og": {
          "$ref": "../../schemas/common.json#/$defs/NullableDiopter"
        },
        "pd_inconsistency_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "eyes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "eye",
              "no_correction",
              "sphere",
              "cylinder",
              "axis",
              "addition",
              "fitting_height"
            ],
            "properties": {
              "id": {
                "$ref": "../../schemas/common.json#/$defs/Ulid"
              },
              "eye": {
                "$ref": "../../schemas/enums.json#/$defs/optical_prescription_eyes.eye"
              },
              "no_correction": {
                "type": "boolean"
              },
              "sphere": {
                "$ref": "../../schemas/common.json#/$defs/NullableDiopter"
              },
              "cylinder": {
                "$ref": "../../schemas/common.json#/$defs/NullableDiopter"
              },
              "axis": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 180
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "addition": {
                "$ref": "../../schemas/common.json#/$defs/NullableDiopter"
              },
              "fitting_height": {
                "$ref": "../../schemas/common.json#/$defs/NullableDiopter"
              }
            }
          },
          "maxItems": 2
        },
        "treatments": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "term_code",
              "other_text"
            ],
            "properties": {
              "id": {
                "$ref": "../../schemas/common.json#/$defs/Ulid"
              },
              "term_code": {
                "$ref": "../../schemas/common.json#/$defs/Code"
              },
              "other_text": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "validated_at": {
          "$ref": "../../schemas/common.json#/$defs/NullableInstant"
        },
        "validated_by": {
          "$ref": "../../schemas/common.json#/$defs/NullableUlid"
        },
        "validated_by_name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 180
            },
            {
              "type": "null"
            }
          ]
        },
        "document_id": {
          "$ref": "../../schemas/common.json#/$defs/NullableUlid"
        },
        "updated_at": {
          "$ref": "../../schemas/common.json#/$defs/Instant"
        }
      }
    },
    "ConsultationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "$ref": "#/$defs/Consultation"
        }
      }
    },
    "PrescriptionResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "$ref": "#/$defs/Prescription"
        }
      }
    },
    "PrescriptionList": {
      "description": "Toutes les versions des prescriptions de la consultation, de la plus récente à la plus ancienne.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/Prescription"
          }
        }
      }
    }
  }
}
