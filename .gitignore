# Préparation locale et fichiers temporaires
/.spec-work/
__pycache__/
*.py[cod]
.DS_Store
Thumbs.db

# Originaux conservés dans le dossier de travail ; extractions dans specifications/sources
/*.docx
/*.pdf

# Dépendances/builds de l’application à développer
/vendor/
/node_modules/
/public/build/
/public/hot
/storage/*.key
# storage/ : le contenu (logs, caches, sessions, vues compilées, fichiers privés) est ignoré par les
# .gitignore de chaque sous-dossier, qui restent suivis pour que l'arborescence existe après un clone.

# Configuration privée
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# Laravel : fichiers locaux et caches
/public/storage
/public/fonts-manifest.dev.json
/bootstrap/cache/*.php
/storage/pail
*.sqlite
*.sqlite-journal
.env.backup
/auth.json
Homestead.json
Homestead.yaml
_ide_helper.php

# Outils de test et de qualité
/.phpunit.cache
.phpunit.result.cache
/.phpstan.cache
/.eslintcache
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
*.tsbuildinfo

# Éditeurs
/.idea
/.vscode
/.zed
/.nova
/.cursor/
/.codex
